<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Conference.Maui.Models"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             x:Class="Conference.Maui.Controls.SessionCardView"
             x:DataType="models:SessionItem">

    <Grid Padding="12,4" BackgroundColor="Transparent"
          SemanticProperties.Description="{Binding AccessibleDescription}"
          SemanticProperties.Hint="Double tap for session details">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup Name="CommonStates">
                <VisualState Name="Normal">
                    <VisualState.Setters>
                        <Setter Property="BackgroundColor" Value="Transparent" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState Name="Selected">
                    <VisualState.Setters>
                        <Setter Property="BackgroundColor" Value="Transparent" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Border Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 12"
                Background="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}"
                Padding="16">

            <Grid RowDefinitions="Auto,Auto">
                <!-- Title -->
                <Label Grid.Row="0"
                       Text="{Binding Title}"
                       FontSize="16"
                       FontAttributes="Bold"
                       LineBreakMode="TailTruncation"
                       MaxLines="2" />

                <!-- Metadata + Avatars -->
                <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                    <HorizontalStackLayout Grid.Column="0" Spacing="16" VerticalOptions="Center">
                        <!-- Reminder bell badge -->
                        <Border StrokeShape="RoundRectangle 8"
                                BackgroundColor="{AppThemeBinding Light=#EEF2FF, Dark=#312E81}"
                                StrokeThickness="0"
                                Padding="5,2"
                                VerticalOptions="Center"
                                IsVisible="{Binding HasReminder}">
                            <HorizontalStackLayout Spacing="3">
                                <Image HeightRequest="11" WidthRequest="11"
                                       VerticalOptions="Center"
                                       SemanticProperties.Description=""
                                       mi:MauiIcon.Value="{mi:Fluent Icon=Alert16, IconColor={AppThemeBinding Light={StaticResource PrimaryDeep}, Dark=#93C5FD}}" />
                                <Label Text="{Binding StartsAt.DateTime, StringFormat='{0:h:mm tt}'}"
                                       FontSize="11" FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource PrimaryDeep}, Dark=#93C5FD}"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>

                        <!-- Room -->
                        <HorizontalStackLayout Spacing="4" VerticalOptions="Center"
                                               IsVisible="{Binding RoomName, Converter={toolkit:IsNotNullConverter}}">
                            <Image Source="location_regular.png" 
                                   HeightRequest="16" WidthRequest="16"
                                   VerticalOptions="Center"
                                   SemanticProperties.Description="">
                                <Image.Behaviors>
                                    <toolkit:IconTintColorBehavior TintColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
                                </Image.Behaviors>
                            </Image>
                            <Label Text="{Binding RoomName}"
                                   FontSize="13"
                                   VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
                        </HorizontalStackLayout>

                        <!-- Duration -->
                        <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                            <Image Source="clock_regular.png" 
                                   HeightRequest="16" WidthRequest="16"
                                   VerticalOptions="Center"
                                   SemanticProperties.Description="">
                                <Image.Behaviors>
                                    <toolkit:IconTintColorBehavior TintColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
                                </Image.Behaviors>
                            </Image>
                            <Label Text="{Binding DurationDisplay}"
                                   FontSize="13"
                                   VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
                        </HorizontalStackLayout>
                    </HorizontalStackLayout>

                    <!-- Overlapping Speaker Avatars -->
                    <HorizontalStackLayout Grid.Column="1"
                                           VerticalOptions="Center"
                                           IsVisible="{Binding HasSpeaker1}">
                        <Border StrokeShape="RoundRectangle 14"
                                HeightRequest="28" WidthRequest="28"
                                StrokeThickness="2"
                                Stroke="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}"
                                Background="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
                                IsVisible="{Binding HasSpeaker1}">
                            <Image Source="{Binding Speaker1.ProfilePictureUrl}"
                                   SemanticProperties.Description=""
                                   Aspect="AspectFill" />
                        </Border>
                        <Border StrokeShape="RoundRectangle 14"
                                HeightRequest="28" WidthRequest="28"
                                StrokeThickness="2"
                                Stroke="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}"
                                Background="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
                                Margin="-10,0,0,0"
                                IsVisible="{Binding HasSpeaker2}">
                            <Image Source="{Binding Speaker2.ProfilePictureUrl}"
                                   SemanticProperties.Description=""
                                   Aspect="AspectFill" />
                        </Border>
                        <Border StrokeShape="RoundRectangle 14"
                                HeightRequest="28" WidthRequest="28"
                                StrokeThickness="2"
                                Stroke="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}"
                                Background="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
                                Margin="-10,0,0,0"
                                IsVisible="{Binding HasSpeaker3}">
                            <Image Source="{Binding Speaker3.ProfilePictureUrl}"
                                   SemanticProperties.Description=""
                                   Aspect="AspectFill" />
                        </Border>
                        <Border StrokeShape="RoundRectangle 14"
                                HeightRequest="28" WidthRequest="28"
                                StrokeThickness="2"
                                Stroke="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}"
                                Background="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
                                Margin="-10,0,0,0"
                                IsVisible="{Binding HasSpeaker4}">
                            <Image Source="{Binding Speaker4.ProfilePictureUrl}"
                                   SemanticProperties.Description=""
                                   Aspect="AspectFill" />
                        </Border>
                        <Border StrokeShape="RoundRectangle 14"
                                HeightRequest="28" WidthRequest="28"
                                StrokeThickness="2"
                                Stroke="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}"
                                Background="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
                                Margin="-10,0,0,0"
                                IsVisible="{Binding HasMoreSpeakers}">
                            <Label Text="{Binding MoreSpeakersText}"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
                        </Border>
                    </HorizontalStackLayout>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</ContentView>
