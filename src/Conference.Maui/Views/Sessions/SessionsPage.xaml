<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Conference.Maui.ViewModels"
             xmlns:models="clr-namespace:Conference.Maui.Models"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="Conference.Maui.Views.Sessions.SessionsPage"
             x:DataType="vm:SessionsViewModel"
             Title="{Binding Title}">

    <ContentPage.Resources>
        <!-- Page-specific resources if needed -->
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*">
        <!-- Search Bar -->
        <SearchBar Grid.Row="0"
                   Placeholder="Search sessions..."
                   Text="{Binding SearchText}"
                   Margin="10,10,10,0"/>

        <!-- Day Selector -->
        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Days}"
                        SelectedItem="{Binding SelectedDay}"
                        SelectionMode="Single"
                        HeightRequest="60"
                        Margin="10,5">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Horizontal" ItemSpacing="10"/>
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:DaySchedule">
                    <Border Padding="20,10"
                            Stroke="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource Primary}}"
                            StrokeThickness="2">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8"/>
                        </Border.StrokeShape>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup Name="CommonStates">
                                <VisualState Name="Normal">
                                    <VisualState.Setters>
                                        <Setter Property="BackgroundColor" Value="Transparent"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState Name="Selected">
                                    <VisualState.Setters>
                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource Primary}}"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Label Text="{Binding Date, StringFormat='{0:MMM dd}'}"
                               FontAttributes="Bold"
                               VerticalOptions="Center"
                               HorizontalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray200}}">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding Source={RelativeSource AncestorType={x:Type Border}}, Path=BackgroundColor}" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource Primary}}">
                                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource White}}"/>
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Sessions List with Sticky Headers -->
        <Grid Grid.Row="2">
            <!-- Loading Indicator -->
            <ActivityIndicator IsRunning="{Binding IsBusy}"
                              IsVisible="{Binding IsBusy}"
                              Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource Primary}}"
                              VerticalOptions="Center"
                              HorizontalOptions="Center"
                              HeightRequest="50"
                              WidthRequest="50"/>
            
            <!-- CollectionView with Grouped Sessions -->
            <CollectionView x:Name="SessionsListView"
                           ItemsSource="{Binding GroupedSessions}"
                           IsVisible="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                           SelectionMode="None"
                           IsGrouped="True"
                           Margin="10,0">
                
                <!-- Group Header Template -->
                <CollectionView.GroupHeaderTemplate>
                    <DataTemplate>
                        <Grid BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray800}}"
                              Padding="15,10"
                              HeightRequest="44">
                            <Label Text="{Binding Key}"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center"/>
                        </Grid>
                    </DataTemplate>
                </CollectionView.GroupHeaderTemplate>
                
                <!-- Session Item Template -->
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Session">
                            <Border Margin="10,5"
                                    Padding="15"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}"
                                    StrokeThickness="1"
                                    Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12"/>
                                </Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SessionsViewModel}}, Path=SessionTappedCommand}"
                                                         CommandParameter="{Binding .}"/>
                                </Border.GestureRecognizers>
                                
                                <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="*,Auto">
                                    <!-- Title -->
                                    <Label Grid.Row="0" Grid.Column="0"
                                           Text="{Binding Title}"
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           LineBreakMode="WordWrap"
                                           Margin="0,0,0,8"/>
                                    
                                    <!-- Favorite Icon -->
                                    <Image Grid.Row="0" Grid.Column="1"
                                           Source="{Binding IsFavorite, Converter={StaticResource FavoriteStarConverter}}"
                                           HeightRequest="24"
                                           WidthRequest="24"
                                           VerticalOptions="Start"
                                           HorizontalOptions="End">
                                        <Image.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SessionsViewModel}}, Path=ToggleFavoriteCommand}"
                                                                CommandParameter="{Binding .}"/>
                                        </Image.GestureRecognizers>
                                    </Image>
                                    
                                    <!-- Room and Time -->
                                    <HorizontalStackLayout Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Spacing="10" Margin="0,0,0,8">
                                        <Label Text="{Binding Room}"
                                               FontSize="14"
                                               FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource Primary}}"/>
                                        <Label Text="{Binding StartTime, StringFormat='{0:HH:mm}'}"
                                               FontSize="14"
                                               TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}"/>
                                        <Label Text="-"
                                               FontSize="14"
                                               TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}"/>
                                        <Label Text="{Binding EndTime, StringFormat='{0:HH:mm}'}"
                                               FontSize="14"
                                               TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}"/>
                                    </HorizontalStackLayout>
                                    
                                    <!-- Category -->
                                    <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}"
                                            Padding="8,4"
                                            Margin="0,0,0,8"
                                            HorizontalOptions="Start">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="6"/>
                                        </Border.StrokeShape>
                                        <Label Text="{Binding Category}"
                                               FontSize="12"
                                               TextColor="{AppThemeBinding Light={StaticResource Gray700}, Dark={StaticResource Gray300}}"/>
                                    </Border>
                                    
                                    <!-- Speakers -->
                                    <HorizontalStackLayout Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Spacing="10">
                                        <!-- Speaker Profile Images (Overlapping) -->
                                        <HorizontalStackLayout Spacing="-15">
                                            <CollectionView ItemsSource="{Binding Speakers}"
                                                           HeightRequest="32"
                                                           SelectionMode="None">
                                                <CollectionView.ItemsLayout>
                                                    <LinearItemsLayout Orientation="Horizontal" ItemSpacing="-15"/>
                                                </CollectionView.ItemsLayout>
                                                <CollectionView.ItemTemplate>
                                                    <DataTemplate x:DataType="models:Speaker">
                                                        <Border HeightRequest="32"
                                                               WidthRequest="32"
                                                               StrokeThickness="2"
                                                               Stroke="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}"
                                                               BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}">
                                                            <Border.StrokeShape>
                                                                <Ellipse/>
                                                            </Border.StrokeShape>
                                                            <Image Source="{Binding ProfilePicture}"
                                                                  Aspect="AspectFill"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </CollectionView.ItemTemplate>
                                            </CollectionView>
                                        </HorizontalStackLayout>

                                        <!-- Speaker Names -->
                                        <Label FontSize="14"
                                               Text="{Binding Speakers, Converter={StaticResource SpeakersToStringConverter}}"
                                               TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}"
                                               VerticalOptions="Center"/>
                                    </HorizontalStackLayout>
                                </Grid>
                            </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
    </Grid>
</ContentPage>
