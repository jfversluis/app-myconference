<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Conference.Maui.ViewModels"
             xmlns:models="clr-namespace:Conference.Maui.Models"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="Conference.Maui.Views.Speakers.SpeakerDetailPage"
             x:DataType="vm:SpeakerDetailViewModel"
             Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">
            <!-- Profile Image -->
            <Border WidthRequest="150"
                   HeightRequest="150"
                   HorizontalOptions="Center"
                   StrokeThickness="0">
                <Border.StrokeShape>
                    <Ellipse/>
                </Border.StrokeShape>
                <Image Source="{Binding Speaker.ProfilePicture}"
                      Aspect="AspectFill"/>
            </Border>

            <!-- Name -->
            <Label Text="{Binding Speaker.FullName}"
                   FontSize="28"
                   FontAttributes="Bold"
                   HorizontalTextAlignment="Center"/>

            <!-- Tag Line -->
            <Label Text="{Binding Speaker.TagLine}"
                   FontSize="18"
                   TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}"
                   HorizontalTextAlignment="Center"
                   IsVisible="{Binding Speaker.TagLine, Converter={toolkit:IsStringNotNullOrEmptyConverter}}"/>

            <!-- Bio -->
            <Label Text="{Binding Speaker.Bio}"
                   FontSize="16"
                   LineBreakMode="WordWrap"
                   IsVisible="{Binding Speaker.Bio, Converter={toolkit:IsStringNotNullOrEmptyConverter}}"/>

            <!-- Sessions -->
            <VerticalStackLayout Spacing="10"
                               IsVisible="{Binding Speaker.Sessions.Count, Converter={toolkit:CompareConverter ComparisonOperator=Greater, ComparingValue=0, TrueObject=True, FalseObject=False}}">
                <Label Text="Sessions"
                       FontSize="20"
                       FontAttributes="Bold"/>

                <CollectionView ItemsSource="{Binding Speaker.Sessions}"
                              SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:SessionLink">
                            <Border Margin="0,5"
                                  Padding="15"
                                  BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}"
                                  StrokeThickness="1"
                                  Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12"/>
                                </Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SpeakerDetailViewModel}}, Path=SessionTappedCommand}"
                                                         CommandParameter="{Binding .}"/>
                                </Border.GestureRecognizers>

                                <Label Text="{Binding Name}"
                                       FontSize="16"
                                       FontAttributes="Bold"/>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>

            <!-- Social Links -->
            <VerticalStackLayout Spacing="10"
                               IsVisible="{Binding Speaker.Links.Count, Converter={toolkit:CompareConverter ComparisonOperator=Greater, ComparingValue=0, TrueObject=True, FalseObject=False}}">
                <Label Text="Links"
                       FontSize="20"
                       FontAttributes="Bold"/>

                <CollectionView ItemsSource="{Binding Speaker.Links}"
                              SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Link">
                            <HorizontalStackLayout Spacing="10" Padding="0,5">
                                <Label Text="{Binding Title}"
                                       FontSize="16"
                                       TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource Primary}}"
                                       TextDecorations="Underline"/>
                                <HorizontalStackLayout.GestureRecognizers>
                                    <TapGestureRecognizer Command="{toolkit:OpenUrlCommand Url={Binding Url}}"/>
                                </HorizontalStackLayout.GestureRecognizers>
                            </HorizontalStackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>