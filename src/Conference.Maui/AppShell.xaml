<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Conference.Maui.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:Conference.Maui.Pages"
    Shell.FlyoutBehavior="Disabled"
    Title="MyConference">

    <TabBar>
        <Tab Title="Sessions" Icon="calendar_regular.png">
            <ShellContent
                Title="Sessions"
                ContentTemplate="{DataTemplate pages:SessionsPage}"
                Route="Sessions" />
        </Tab>
        <Tab Title="Speakers" Icon="people_regular.png">
            <ShellContent
                Title="Speakers"
                ContentTemplate="{DataTemplate pages:SpeakersPage}"
                Route="Speakers" />
        </Tab>
        <Tab Title="My Agenda" Icon="star.png">
            <ShellContent
                Title="My Agenda"
                ContentTemplate="{DataTemplate pages:FavoritesPage}"
                Route="Favorites" />
        </Tab>
        <Tab Title="About" Icon="info_regular.png">
            <ShellContent
                Title="About"
                ContentTemplate="{DataTemplate pages:AboutPage}"
                Route="About" />
        </Tab>
    </TabBar>
</Shell>
