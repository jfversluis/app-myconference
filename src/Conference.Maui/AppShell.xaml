<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Conference.Maui.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:sessions="clr-namespace:Conference.Maui.Views.Sessions"
    xmlns:speakers="clr-namespace:Conference.Maui.Views.Speakers"
    xmlns:favorites="clr-namespace:Conference.Maui.Views.Favorites"
    xmlns:about="clr-namespace:Conference.Maui.Views.About"
    Shell.FlyoutBehavior="Disabled">

    <TabBar>
        <ShellContent
            Title="Sessions"
            Icon="calendar.png"
            Route="sessions"
            ContentTemplate="{DataTemplate sessions:SessionsPage}" />

        <ShellContent
            Title="Speakers"
            Icon="person.png"
            Route="speakers"
            ContentTemplate="{DataTemplate speakers:SpeakersPage}" />

        <ShellContent
            Title="Favorites"
            Icon="star.png"
            Route="favorites"
            ContentTemplate="{DataTemplate favorites:FavoritesPage}" />

        <ShellContent
            Title="About"
            Icon="info.png"
            Route="about"
            ContentTemplate="{DataTemplate about:AboutPage}" />
    </TabBar>

</Shell>
