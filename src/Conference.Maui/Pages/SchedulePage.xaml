<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Conference.Maui.Pages.SchedulePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Conference.Maui.Controls"
    xmlns:localization="clr-namespace:Conference.Maui.Resources.Strings"
    xmlns:models="clr-namespace:Conference.Maui.Models"
    xmlns:syncfusion="clr-namespace:Syncfusion.Maui.Toolkit.TabView;assembly=Syncfusion.Maui.Toolkit"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:viewmodels="clr-namespace:Conference.Maui.ViewModels"
    xmlns:converters="clr-namespace:Conference.Maui.Converters"
    xmlns:selectors="clr-namespace:Conference.Maui.Selectors"
    Title="{x:Static localization:Strings.SchedulePageTitle}"
    x:DataType="viewmodels:ScheduleViewModel">

    <ContentPage.Resources>
        <ResourceDictionary>
            <!-- Converters -->
            <converters:PluralConverter x:Key="PluralConverter" />
            <converters:StringToBoolConverter x:Key="StringToBoolConverter" />
            
            <!-- Grouped Session Template -->
            <DataTemplate x:Key="GroupedSessionTemplate" x:DataType="models:Session">
                <Border Style="{StaticResource SessionCardStyle}">

                    <Grid ColumnSpacing="12" 
                          RowSpacing="6">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding x:DataType='viewmodels:ScheduleViewModel', Source={RelativeSource AncestorType={x:Type viewmodels:ScheduleViewModel}}, Path=GoToSessionDetailsCommand}" CommandParameter="{Binding .}" />
                        </Grid.GestureRecognizers>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Session Title -->
                        <Label Grid.Row="0" Grid.Column="0"
                               Text="{Binding Title}"
                               Style="{StaticResource SessionTitleStyle}" />

                        <!-- Session Description -->
                        <Label Grid.Row="1" Grid.Column="0"
                               Text="{Binding Description}"
                               Style="{StaticResource SessionDescriptionStyle}" />

                        <!-- Speaker and Room Info -->
                        <Grid Grid.Row="2" Grid.Column="0" 
                              ColumnSpacing="8"
                              Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Speaker Avatar -->
                            <toolkit:AvatarView Grid.Column="0"
                                              CornerRadius="16"
                                              HeightRequest="32"
                                              WidthRequest="32"
                                              VerticalOptions="Center"
                                              ImageSource="{Binding SpeakerProfilePicture}" />

                            <!-- Speaker Name -->
                            <Label Grid.Column="1"
                                   Text="{Binding Speakers[0].FullName, FallbackValue='Speaker TBA'}"
                                   Style="{StaticResource SpeakerNameStyle}"
                                   VerticalOptions="Center" />

                            <!-- Room and Duration -->
                            <StackLayout Grid.Column="2" 
                                       Orientation="Horizontal" 
                                       Spacing="8"
                                       VerticalOptions="Center">
                                <Label Text="{Binding Room}"
                                       FontSize="12"
                                       FontFamily="OpenSansRegular"
                                       FontAttributes="Bold"
                                       TextColor="{toolkit:AppThemeResource ThemePrimary}"
                                       VerticalOptions="Center" />
                                <Label Text="•"
                                       FontSize="12"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray400}}"
                                       VerticalOptions="Center" />
                                <Label Text="{Binding DurationInMinutes, StringFormat='{0}min'}"
                                       FontSize="12"
                                       FontFamily="OpenSansRegular"
                                       TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}"
                                       VerticalOptions="Center" />
                            </StackLayout>
                        </Grid>

                    </Grid>
                </Border>
            </DataTemplate>
            
            <!-- Time Header Template for flattened view -->
            <DataTemplate x:Key="TimeHeaderTemplate" x:DataType="models:TimeHeader">
                <Border Style="{StaticResource TimeSlotHeaderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Time Display -->
                        <Label Grid.Column="0"
                               Text="{Binding TimeDisplayText}"
                               FontFamily="PoppinsSemibold"
                               FontSize="14"
                               TextColor="{toolkit:AppThemeResource ThemePrimary}"
                               VerticalOptions="Center"
                               HorizontalOptions="Start" />

                        <!-- Session Count -->
                        <Label Grid.Column="1"
                               Text="{Binding SessionCount, Converter={StaticResource PluralConverter}}"
                               FontFamily="OpenSansRegular"
                               FontSize="11"
                               TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}"
                               VerticalOptions="Center"
                               HorizontalOptions="End" />
                    </Grid>
                </Border>
            </DataTemplate>
            
            <!-- Template Selector -->
            <selectors:ScheduleTemplateSelector x:Key="ScheduleTemplateSelector"
                                               TimeHeaderTemplate="{StaticResource TimeHeaderTemplate}"
                                               SessionTemplate="{StaticResource GroupedSessionTemplate}" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <Grid Style="{StaticResource PageBackgroundStyle}">
        <!-- Loading Overlay -->
        <Grid IsVisible="{Binding IsLoading}" 
              BackgroundColor="{AppThemeBinding Light={StaticResource LightBackground}, Dark={StaticResource DarkBackground}}"
              ZIndex="999">
            <StackLayout VerticalOptions="Center" HorizontalOptions="Center">
                <ActivityIndicator IsRunning="{Binding IsLoading}" 
                                 Color="{toolkit:AppThemeResource ThemePrimary}"
                                 WidthRequest="50" 
                                 HeightRequest="50" />
                <Label Text="{Binding LoadingMessage}"
                       FontFamily="OpenSansRegular"
                       FontSize="16"
                       TextColor="{AppThemeBinding Light={StaticResource LightTextPrimary}, Dark={StaticResource DarkTextPrimary}}"
                       HorizontalOptions="Center"
                       Margin="0,10,0,0" />
            </StackLayout>
        </Grid>

        <!-- Error Message -->
        <StackLayout IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}"
                     VerticalOptions="Center"
                     HorizontalOptions="Center"
                     Margin="20"
                     ZIndex="998">
            <Label Text="{Binding ErrorMessage}"
                   FontFamily="OpenSansRegular"
                   FontSize="14"
                   TextColor="Red"
                   HorizontalTextAlignment="Center" />
            <Button Text="Retry"
                    Clicked="OnRetryClicked"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Margin="0,10,0,0" />
        </StackLayout>

        <!-- Main Content -->
        <Grid IsVisible="{Binding HasData}">
            <!-- Show TabView only if there are multiple days -->
            <syncfusion:SfTabView 
                x:Name="tabView"
                EnableSwiping="False"
                IsVisible="{Binding ShowTabs}"
                BackgroundColor="{AppThemeBinding Light={StaticResource LightBackground}, Dark={StaticResource DarkBackground}}"
                IndicatorBackground="{toolkit:AppThemeResource ThemePrimary}"
                IndicatorWidthMode="Stretch">
            </syncfusion:SfTabView>

            <!-- Show regular CollectionView with RefreshView if there's only one day -->
            <Grid IsVisible="{Binding ShowTabs, Converter={StaticResource InvertedBoolConverter}}">
                <RefreshView x:Name="scheduleRefreshView"
                             IsRefreshing="{Binding IsRefreshing}">
                    <CollectionView 
                        x:Name="scheduleCollectionView"
                        ItemsSource="{Binding FlattenedItems}"
                        ItemTemplate="{StaticResource ScheduleTemplateSelector}"
                        BackgroundColor="{AppThemeBinding Light={StaticResource LightBackground}, Dark={StaticResource DarkBackground}}"
                        Margin="10"
                        ItemSizingStrategy="MeasureFirstItem"
                        RemainingItemsThreshold="10">
                        <CollectionView.Behaviors>
                            <controls:StickyHeaderBehavior 
                                StickyHeaderTemplate="{StaticResource TimeHeaderTemplate}"
                                HeaderContainer="{x:Reference stickyHeaderContainer}" />
                        </CollectionView.Behaviors>
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout ItemSpacing="2" Orientation="Vertical" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.Header>
                            <BoxView HeightRequest="8" BackgroundColor="Transparent" />
                        </CollectionView.Header>
                        <CollectionView.Footer>
                            <BoxView HeightRequest="80" BackgroundColor="Transparent" />
                        </CollectionView.Footer>
                    </CollectionView>
                </RefreshView>
                
                <!-- Sticky Header Container -->
                <ContentView x:Name="stickyHeaderContainer"
                             VerticalOptions="Start"
                             HorizontalOptions="Fill"
                             IsVisible="False"
                             ZIndex="999" />
            </Grid>
        </Grid>

        <!-- <controls:FloatingButton
            Command="{Binding GoToPickFavoriteSessionsPageCommand}"
            ImageSource="icon_myagenda.png"
            SemanticProperties.Description="Select favorite sessions"
            IsVisible="{Binding HasData}" /> -->
    </Grid>
</ContentPage>