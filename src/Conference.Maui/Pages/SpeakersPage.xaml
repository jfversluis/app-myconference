<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:syncfusion="clr-namespace:Syncfusion.Maui.Toolkit.TabView;assembly=Syncfusion.Maui.Toolkit"
             xmlns:viewmodels="clr-namespace:Conference.Maui.ViewModels"
             xmlns:models="clr-namespace:Conference.Maui.Models"
             xmlns:converters="clr-namespace:Conference.Maui.Converters"
             xmlns:localization="clr-namespace:Conference.Maui.Resources.Strings"
             x:DataType="viewmodels:SpeakersViewModel"
             x:Class="Conference.Maui.Pages.SpeakersPage"
             Title="{x:Static localization:Strings.SpeakersPageTitle}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <!-- Speaker Data Template -->
            <DataTemplate x:Key="SpeakerTemplate" x:DataType="models:Speaker">
                <Border Style="{StaticResource SpeakerCardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding x:DataType='viewmodels:SpeakersViewModel', Source={RelativeSource AncestorType={x:Type viewmodels:SpeakersViewModel}}, Path=GoToSpeakerDetailsCommand}" CommandParameter="{Binding .}" />
                        </Grid.GestureRecognizers>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Speaker Avatar Column -->
                        <Grid Grid.Column="0" 
                              VerticalOptions="Start"
                              HorizontalOptions="Center"
                              WidthRequest="80">
                            <toolkit:AvatarView
                                CornerRadius="36"
                                HeightRequest="72"
                                WidthRequest="72"
                                ImageSource="{Binding ProfilePicture}">
                                <toolkit:AvatarView.Shadow>
                                    <Shadow Brush="{toolkit:AppThemeResource ThemePrimary}" 
                                            Offset="0,3" 
                                            Radius="8" 
                                            Opacity="0.2" />
                                </toolkit:AvatarView.Shadow>
                            </toolkit:AvatarView>
                        </Grid>

                        <!-- Main Content Column -->
                        <Grid Grid.Column="1" 
                              RowSpacing="12"
                              VerticalOptions="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                        
                            <!-- Speaker Name -->
                            <Label Grid.Row="0"
                                   Text="{Binding FullName}"
                                   FontFamily="PoppinsSemibold"
                                   FontSize="20"
                                   TextColor="{toolkit:AppThemeResource ThemeTextPrimary}"
                                   MaxLines="1" />

                            <!-- Speaker TagLine -->
                            <Label Grid.Row="1"
                                   Text="{Binding TagLine}"
                                   FontSize="16"
                                   FontFamily="OpenSansRegular"
                                   FontAttributes="Bold"
                                   LineBreakMode="TailTruncation"
                                   MaxLines="1"
                                   TextColor="{toolkit:AppThemeResource ThemePrimary}"
                                   Margin="0,-4,0,0" />

                            <!-- Speaker Bio -->
                            <Label Grid.Row="2"
                                   Text="{Binding Bio}"
                                   FontFamily="OpenSansRegular"
                                   FontSize="15"
                                   TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}"
                                   LineBreakMode="TailTruncation"
                                   MaxLines="2"
                                   Margin="0,4,0,0" />
                        </Grid>
                    </Grid>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid Style="{StaticResource PageBackgroundStyle}">
        <!-- Loading indicator overlay -->
        <Frame IsVisible="{Binding IsLoading}"
               BackgroundColor="{AppThemeBinding Light={StaticResource LightBackground}, Dark={StaticResource DarkBackground}}"
               HasShadow="False"
               BorderColor="Transparent"
               HorizontalOptions="FillAndExpand"
               VerticalOptions="FillAndExpand"
               ZIndex="1000">
            <StackLayout VerticalOptions="Center" 
                        HorizontalOptions="Center"
                        Spacing="20">
                <ActivityIndicator IsRunning="{Binding IsLoading}"
                                 Color="{toolkit:AppThemeResource ThemePrimary}"
                                 WidthRequest="40"
                                 HeightRequest="40" />
                <Label Text="Loading speakers..."
                       FontFamily="OpenSansRegular"
                       FontSize="16"
                       TextColor="{AppThemeBinding Light={StaticResource LightTextSecondary}, Dark={StaticResource DarkTextSecondary}}"
                       HorizontalOptions="Center" />
            </StackLayout>
        </Frame>

        <!-- Speakers List with Pull-to-Refresh -->
        <RefreshView IsRefreshing="{Binding IsRefreshing}"
                     Command="{Binding RefreshDataCommand}">
            <CollectionView 
                ItemsSource="{Binding Speakers}"
                ItemTemplate="{StaticResource SpeakerTemplate}"
                BackgroundColor="{AppThemeBinding Light={StaticResource LightBackground}, Dark={StaticResource DarkBackground}}">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout ItemSpacing="0" Orientation="Vertical" />
                </CollectionView.ItemsLayout>
                <CollectionView.Header>
                    <BoxView HeightRequest="16" BackgroundColor="Transparent" />
                </CollectionView.Header>
                <CollectionView.Footer>
                    <BoxView HeightRequest="24" BackgroundColor="Transparent" />
                </CollectionView.Footer>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>