<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:syncfusion="clr-namespace:Syncfusion.Maui.Toolkit.TabView;assembly=Syncfusion.Maui.Toolkit"
             xmlns:viewmodels="clr-namespace:Conference.Maui.ViewModels"
             xmlns:models="clr-namespace:Conference.Maui.Models"
             xmlns:converters="clr-namespace:Conference.Maui.Converters"
             xmlns:localization="clr-namespace:Conference.Maui.Resources.Strings"
             x:DataType="viewmodels:SpeakersViewModel"
             x:Class="Conference.Maui.Pages.SpeakersPage"
             Title="{x:Static localization:Strings.SpeakersPageTitle}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <!-- Converters -->
            <converters:StringToBoolConverter x:Key="StringToBoolConverter" />
            <toolkit:InvertedBoolConverter x:Key="InvertedBoolConverter" />
            
            <!-- Speaker Data Template -->
            <DataTemplate x:Key="SpeakerTemplate" x:DataType="models:Speaker">
                <Border Style="{StaticResource SpeakerCardStyle}">
                    <Grid ColumnSpacing="12">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding x:DataType='viewmodels:SpeakersViewModel', Source={RelativeSource AncestorType={x:Type viewmodels:SpeakersViewModel}}, Path=GoToSpeakerDetailsCommand}" CommandParameter="{Binding .}" />
                        </Grid.GestureRecognizers>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Speaker Avatar Column - Simplified for performance -->
                        <toolkit:AvatarView
                            Grid.Column="0"
                            CornerRadius="28"
                            HeightRequest="56"
                            WidthRequest="56"
                            VerticalOptions="Start"
                            HorizontalOptions="Center"
                            ImageSource="{Binding ProfilePicture}" />

                        <!-- Main Content Column -->
                        <StackLayout Grid.Column="1" 
                                   Spacing="4"
                                   VerticalOptions="Center">
                        
                            <!-- Speaker Name -->
                            <Label Text="{Binding FullName}"
                                   Style="{StaticResource SessionTitleStyle}"
                                   MaxLines="1"
                                   LineBreakMode="TailTruncation" />

                            <!-- Speaker TagLine -->
                            <Label Text="{Binding TagLine}"
                                   FontSize="14"
                                   FontFamily="OpenSansRegular"
                                   FontAttributes="Bold"
                                   LineBreakMode="TailTruncation"
                                   MaxLines="1"
                                   TextColor="{toolkit:AppThemeResource ThemePrimary}" />

                            <!-- Speaker Bio -->
                            <Label Text="{Binding Bio}"
                                   Style="{StaticResource SessionDescriptionStyle}"
                                   LineBreakMode="TailTruncation"
                                   MaxLines="2" />
                        </StackLayout>
                    </Grid>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid Style="{StaticResource PageBackgroundStyle}">
        <!-- Loading Overlay -->
        <Grid IsVisible="{Binding IsLoading}" 
              BackgroundColor="{AppThemeBinding Light={StaticResource LightBackground}, Dark={StaticResource DarkBackground}}"
              ZIndex="999">
            <StackLayout VerticalOptions="Center" HorizontalOptions="Center">
                <ActivityIndicator IsRunning="{Binding IsLoading}" 
                                 Color="{toolkit:AppThemeResource ThemePrimary}"
                                 WidthRequest="50" 
                                 HeightRequest="50" />
                <Label Text="Loading speakers..."
                       FontFamily="OpenSansRegular"
                       FontSize="16"
                       TextColor="{AppThemeBinding Light={StaticResource LightTextPrimary}, Dark={StaticResource DarkTextPrimary}}"
                       HorizontalOptions="Center"
                       Margin="0,10,0,0" />
            </StackLayout>
        </Grid>

        <!-- Error Message -->
        <StackLayout IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}"
                     VerticalOptions="Center"
                     HorizontalOptions="Center"
                     Margin="20"
                     ZIndex="998">
            <Label Text="{Binding ErrorMessage}"
                   FontFamily="OpenSansRegular"
                   FontSize="14"
                   TextColor="Red"
                   HorizontalTextAlignment="Center" />
            <Button Text="Retry"
                    Command="{Binding RefreshCommand}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Margin="0,10,0,0" />
        </StackLayout>

        <!-- Main Content -->
        <Grid IsVisible="{Binding HasData}">
            <RefreshView x:Name="speakersRefreshView"
                         IsRefreshing="{Binding IsRefreshing}"
                         Command="{Binding RefreshCommand}">
                <CollectionView 
                    ItemsSource="{Binding Speakers}"
                    ItemTemplate="{StaticResource SpeakerTemplate}"
                    BackgroundColor="{AppThemeBinding Light={StaticResource LightBackground}, Dark={StaticResource DarkBackground}}"
                    Margin="0"
                    ItemSizingStrategy="MeasureFirstItem">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout ItemSpacing="2" Orientation="Vertical" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.Header>
                        <BoxView HeightRequest="8" BackgroundColor="Transparent" />
                    </CollectionView.Header>
                    <CollectionView.Footer>
                        <BoxView HeightRequest="80" BackgroundColor="Transparent" />
                    </CollectionView.Footer>
                </CollectionView>
            </RefreshView>
        </Grid>
    </Grid>
</ContentPage>