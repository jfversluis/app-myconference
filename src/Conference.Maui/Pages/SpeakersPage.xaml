<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Conference.Maui.ViewModels"
             xmlns:models="clr-namespace:Conference.Maui.Models"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             x:Class="Conference.Maui.Pages.SpeakersPage"
             x:DataType="vm:SpeakersViewModel"
             Title="{Binding Title}"
             Background="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray950}}"
             SafeAreaEdges="None"
             x:Name="ThisPage">

    <Grid RowDefinitions="Auto,*" SafeAreaEdges="None">
        <!-- Search Bar -->
        <Border Grid.Row="0"
                Margin="16,8"
                StrokeShape="RoundRectangle 12"
                Stroke="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray700}}"
                StrokeThickness="1"
                Background="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}"
                Padding="0">
            <Grid ColumnDefinitions="Auto,*" Padding="12,0">
                <Image Grid.Column="0"
                       HeightRequest="18" WidthRequest="18"
                       VerticalOptions="Center"
                       Margin="0,0,8,0"
                       mi:MauiIcon.Value="{mi:Fluent Icon=Search24, IconSize=18, IconColor={AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}}" />
                <Entry Grid.Column="1"
                       x:Name="SpeakerSearchEntry"
                       Placeholder="Search speakers..."
                       Text="{Binding SearchText}"
                       ClearButtonVisibility="WhileEditing"
                       FontSize="16"
                       VerticalOptions="Center"
                       BackgroundColor="Transparent"
                       PlaceholderColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}">
                    <Entry.Behaviors>
                        <toolkit:UserStoppedTypingBehavior
                            BindingContext="{Binding Path=BindingContext, Source={x:Reference SpeakerSearchEntry}, x:DataType=Entry}"
                            Command="{Binding ApplySearchCommand}"
                            StoppedTypingTimeThreshold="300"
                            MinimumLengthThreshold="1"
                            ShouldDismissKeyboardAutomatically="False" />
                    </Entry.Behaviors>
                    <Entry.Style>
                        <Style TargetType="Entry">
                            <Setter Property="VisualStateManager.VisualStateGroups">
                                <VisualStateGroupList>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal">
                                            <VisualState.Setters>
                                                <Setter Property="BackgroundColor" Value="Transparent" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Focused">
                                            <VisualState.Setters>
                                                <Setter Property="BackgroundColor" Value="Transparent" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateGroupList>
                            </Setter>
                        </Style>
                    </Entry.Style>
                </Entry>
            </Grid>
        </Border>

        <!-- Speakers Grid -->
        <CollectionView Grid.Row="1"
                        Margin="4,0"
                        x:Name="SpeakersCollectionView"
                        ItemsSource="{Binding Speakers}"
                        SelectionMode="Single"
                        SelectionChanged="OnSpeakerSelected">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical"
                                 Span="2"
                                 HorizontalItemSpacing="0"
                                 VerticalItemSpacing="8" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:SpeakerItem">
                    <Grid HeightRequest="170" Margin="4,0">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup Name="CommonStates">
                                <VisualState Name="Normal">
                                    <VisualState.Setters>
                                        <Setter Property="BackgroundColor" Value="Transparent" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState Name="Selected">
                                    <VisualState.Setters>
                                        <Setter Property="BackgroundColor" Value="Transparent" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border StrokeShape="RoundRectangle 12"
                                Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                                StrokeThickness="1"
                                Background="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}"
                                Padding="16">
                            <Grid RowDefinitions="64,Auto,*" RowSpacing="6">
                                <!-- Avatar -->
                                <Border Grid.Row="0"
                                        StrokeShape="RoundRectangle 32"
                                        HeightRequest="64"
                                        WidthRequest="64"
                                        StrokeThickness="0"
                                        Background="{StaticResource Primary}"
                                        HorizontalOptions="Center">
                                    <Grid>
                                        <Label Text="{Binding Initials}"
                                               TextColor="White"
                                               FontSize="18"
                                               FontAttributes="Bold"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center" />
                                        <Image Source="{Binding ProfilePictureUrl}"
                                               Aspect="AspectFill"
                                               HeightRequest="64"
                                               WidthRequest="64">
                                            <Image.Clip>
                                                <EllipseGeometry Center="32,32" RadiusX="32" RadiusY="32" />
                                            </Image.Clip>
                                        </Image>
                                    </Grid>
                                </Border>

                                <!-- Name -->
                                <Label Grid.Row="1"
                                       Text="{Binding FullName}"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       HorizontalTextAlignment="Center"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="2" />

                                <!-- Tagline -->
                                <Label Grid.Row="2"
                                       Text="{Binding TagLine}"
                                       FontSize="11"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                                       HorizontalTextAlignment="Center"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="2"
                                       VerticalOptions="Start" />
                            </Grid>
                        </Border>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.Footer>
                <BoxView HeightRequest="120" BackgroundColor="Transparent" />
            </CollectionView.Footer>
            <CollectionView.EmptyView>
                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Padding="32" Spacing="12"
                                     IsVisible="{Binding ShowEmptyState}">
                    <Image HeightRequest="48" WidthRequest="48" HorizontalOptions="Center"
                           mi:MauiIcon.Value="{mi:Fluent Icon=People24, IconSize=48, IconColor={AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}}" />
                    <Label Text="No speakers found"
                           FontSize="18"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
                    <Label Text="Try adjusting your search or check back later."
                           FontSize="14"
                           HorizontalTextAlignment="Center"
                           TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
        </CollectionView>

        <!-- Loading Indicator -->
        <VerticalStackLayout Grid.RowSpan="2"
                             VerticalOptions="Center"
                             HorizontalOptions="Center"
                             Spacing="12"
                             IsVisible="{Binding IsBusy}">
            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               HorizontalOptions="Center"
                               Color="{StaticResource Primary}" />
            <Label Text="Loading speakers..."
                   FontSize="14"
                   HorizontalOptions="Center"
                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
