<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Conference.Maui.ViewModels"
             xmlns:models="clr-namespace:Conference.Maui.Models"
             xmlns:config="clr-namespace:Conference.Maui.Configuration"
             xmlns:controls="clr-namespace:Conference.Maui.Controls"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             x:Class="Conference.Maui.Pages.MyEventPage"
             x:DataType="vm:MyEventViewModel"
             Title="{Binding Title}"
             SafeAreaEdges="None"
             Background="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray950}}">

    <Grid SafeAreaEdges="None">
        <!-- Loading -->
        <ActivityIndicator IsRunning="{Binding IsBusy}"
                           IsVisible="{Binding IsBusy}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           Color="{StaticResource Primary}" />

        <!-- Content -->
        <RefreshView IsRefreshing="{Binding IsRefreshing}"
                     Command="{Binding RefreshDataCommand}">
            <ScrollView IsVisible="{Binding IsBusy, Converter={toolkit:InvertedBoolConverter}}">
            <VerticalStackLayout Spacing="0">

                <!-- Event Header -->
                <Grid Padding="20,16" Background="{StaticResource HeroGradient}"
                      RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
                    <Label Grid.Row="0"
                           Text="{Binding EventDateDisplay}"
                           FontSize="13"
                           TextColor="White" />
                    <Label Grid.Row="1"
                           Text="{Binding EventHeaderTitle}"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="White"
                           SemanticProperties.HeadingLevel="Level1" />
                    <!-- Stats Row -->
                    <HorizontalStackLayout Grid.Row="2" Spacing="16" Margin="0,4,0,0">
                        <HorizontalStackLayout Spacing="4">
                            <Label Text="{Binding TotalSessions}"
                                   FontSize="14" FontAttributes="Bold" TextColor="White" />
                            <Label Text="sessions" FontSize="13" TextColor="White" />
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Spacing="4">
                            <Label Text="{Binding TotalSpeakers}"
                                   FontSize="14" FontAttributes="Bold" TextColor="White" />
                            <Label Text="speakers" FontSize="13" TextColor="White" />
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Spacing="4">
                            <Label Text="{Binding AgendaCount}"
                                   FontSize="14" FontAttributes="Bold" TextColor="White" />
                            <Label Text="in your agenda" FontSize="13" TextColor="White" />
                        </HorizontalStackLayout>
                    </HorizontalStackLayout>
                </Grid>

                <!-- Sections Container -->
                <VerticalStackLayout Spacing="20" Padding="0,16">

                    <!-- HAPPENING NOW Section -->
                    <VerticalStackLayout Spacing="10" IsVisible="{Binding HasNowSessions}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Padding="16,0">
                            <Border x:Name="LiveBadge"
                                    Grid.Column="0"
                                    StrokeShape="RoundRectangle 4"
                                    StrokeThickness="0"
                                    Background="{StaticResource ErrorRed}"
                                    Padding="8,3"
                                    VerticalOptions="Center">
                                <Label Text="LIVE" FontSize="11" FontAttributes="Bold"
                                       TextColor="White" CharacterSpacing="0.5" />
                            </Border>
                            <Label Grid.Column="1"
                                   Text="HAPPENING NOW"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                                   CharacterSpacing="0.5"
                                   VerticalOptions="Center"
                                   SemanticProperties.HeadingLevel="Level2" />
                        </Grid>

                        <CollectionView ItemsSource="{Binding NowSessions}"
                                        SelectionMode="Single"
                                        SelectionChanged="OnSessionSelected"
                                        MinimumHeightRequest="130">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout Orientation="Horizontal" ItemSpacing="10" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.Header>
                                <ContentView WidthRequest="16" />
                            </CollectionView.Header>
                            <CollectionView.Footer>
                                <ContentView WidthRequest="16" />
                            </CollectionView.Footer>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:SessionItem">
                                    <controls:SessionCarouselCardView
                                        BorderStroke="{StaticResource ErrorRed}"
                                        BorderThickness="1.5" />
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>

                    <!-- UP NEXT Section -->
                    <VerticalStackLayout Spacing="10" IsVisible="{Binding HasUpNext}">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Padding="16,0">
                            <Label Grid.Column="0"
                                   Text="UP NEXT"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                                   CharacterSpacing="0.5"
                                   VerticalOptions="Center"
                                   SemanticProperties.HeadingLevel="Level2" />
                            <Label Grid.Column="1"
                                   Text="{Binding UpNextTimeDisplay}"
                                   FontSize="11"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                                   VerticalOptions="Center" />
                            <Border Grid.Column="2"
                                    StrokeShape="RoundRectangle 4"
                                    StrokeThickness="0"
                                    Background="{StaticResource Primary}"
                                    Padding="8,3"
                                    VerticalOptions="Center"
                                    IsVisible="{Binding HasCountdown}">
                                <Label Text="{Binding CountdownText}" FontSize="11" FontAttributes="Bold"
                                       TextColor="White" />
                            </Border>
                        </Grid>

                        <CollectionView ItemsSource="{Binding UpNextSessions}"
                                        SelectionMode="Single"
                                        SelectionChanged="OnSessionSelected"
                                        MinimumHeightRequest="130">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout Orientation="Horizontal" ItemSpacing="10" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.Header>
                                <ContentView WidthRequest="16" />
                            </CollectionView.Header>
                            <CollectionView.Footer>
                                <ContentView WidthRequest="16" />
                            </CollectionView.Footer>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:SessionItem">
                                    <controls:SessionCarouselCardView
                                        BorderStroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                                        BorderThickness="1" />
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>

                    <!-- Onboarding Card -->
                    <Border StrokeShape="RoundRectangle 12"
                            Stroke="{StaticResource Primary}"
                            StrokeThickness="1"
                            Background="{AppThemeBinding Light={StaticResource OnboardingBgLight}, Dark={StaticResource OnboardingBgDark}}"
                            Padding="16"
                            Margin="16,0"
                            IsVisible="{Binding ShowOnboarding}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Build your personal agenda"
                                   FontSize="16" FontAttributes="Bold" />
                            <Label Text="Tap the star on sessions you'd like to attend. Your favorites will appear here so you never miss a talk."
                                   FontSize="13"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}"
                                   LineBreakMode="WordWrap" />
                            <HorizontalStackLayout Spacing="6" IsVisible="{Binding HasWifi}">
                                <Image Source="wifi_regular.png" HeightRequest="14" WidthRequest="14"
                                       VerticalOptions="Center"
                                       SemanticProperties.Description="" />
                                <Label FontSize="13"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="1"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="WiFi: " />
                                            <Span Text="{Binding WifiNetworkName}" FontAttributes="Bold" />
                                            <Span Text=" — see About" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                            </HorizontalStackLayout>
                            <FlexLayout Wrap="Wrap" AlignItems="Center" JustifyContent="Start">
                                <Button Text="Quick Pick"
                                        Command="{Binding NavigateToQuickPickCommand}"
                                        IsVisible="{Binding IsQuickPickEnabled}"
                                        BackgroundColor="{StaticResource Primary}"
                                        TextColor="White"
                                        FontAttributes="Bold"
                                        CornerRadius="8"
                                        HorizontalOptions="Start"
                                        Padding="20,10"
                                        Margin="0,0,8,0"
                                        mi:MauiIcon.Value="{mi:Fluent Icon=Flash28, IconColor=White}" />
                                <Button Text="Browse Sessions"
                                        Command="{Binding NavigateToSessionsCommand}"
                                        BackgroundColor="Transparent"
                                        TextColor="{StaticResource Primary}"
                                        FontAttributes="Bold"
                                        CornerRadius="8"
                                        HorizontalOptions="Start"
                                        Padding="20,10" />
                            </FlexLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- MY AGENDA TODAY Section -->
                    <VerticalStackLayout Spacing="10" Padding="16,0" IsVisible="{Binding HasTodayAgenda}">
                        <Label Text="YOUR AGENDA TODAY"
                               FontSize="11"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                               CharacterSpacing="0.5"
                               SemanticProperties.HeadingLevel="Level2" />

                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding TodayAgenda}"
                                             Spacing="0">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:SessionItem">
                                    <Grid ColumnDefinitions="56,Auto,*" ColumnSpacing="12"
                                          Padding="0,10" MinimumHeightRequest="56"
                                          SemanticProperties.Description="{Binding AccessibleDescription}"
                                          SemanticProperties.Hint="Double tap for session details">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnSessionTapped" />
                                        </Grid.GestureRecognizers>
                                        <!-- Time -->
                                        <Label Grid.Column="0"
                                               Text="{Binding StartsAt.LocalDateTime, StringFormat='{0:h:mm tt}'}"
                                               FontSize="12" FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                                               VerticalOptions="Start" />
                                        <!-- Timeline dot + line -->
                                        <Grid Grid.Column="1" WidthRequest="12" VerticalOptions="Fill">
                                            <BoxView HeightRequest="1" WidthRequest="12"
                                                     Color="{StaticResource Primary}"
                                                     VerticalOptions="Start" Margin="0,6,0,0"
                                                     CornerRadius="6"
                                                     SemanticProperties.Description="" />
                                            <BoxView WidthRequest="2"
                                                     Color="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
                                                     HorizontalOptions="Center"
                                                     VerticalOptions="Fill"
                                                     Margin="0,12,0,0"
                                                     SemanticProperties.Description="" />
                                        </Grid>
                                        <!-- Session info -->
                                        <VerticalStackLayout Grid.Column="2" Spacing="2" VerticalOptions="Start">
                                            <Label Text="{Binding Title}" FontSize="14" FontAttributes="Bold"
                                                   LineBreakMode="TailTruncation" MaxLines="2" />
                                            <HorizontalStackLayout Spacing="8">
                                                <!-- Reminder bell badge -->
                                                <Border StrokeShape="RoundRectangle 8"
                                                        BackgroundColor="{AppThemeBinding Light=#EEF2FF, Dark=#312E81}"
                                                        StrokeThickness="0"
                                                        Padding="5,2"
                                                        VerticalOptions="Center"
                                                        IsVisible="{Binding HasReminder}">
                                                    <HorizontalStackLayout Spacing="3">
                                                        <Image HeightRequest="11" WidthRequest="11"
                                                               VerticalOptions="Center"
                                                               SemanticProperties.Description=""
                                                               mi:MauiIcon.Value="{mi:Fluent Icon=Alert16, IconColor={AppThemeBinding Light={StaticResource PrimaryDeep}, Dark=#93C5FD}}" />
                                                        <Label Text="{Binding StartsAt.LocalDateTime, StringFormat='{0:h:mm tt}'}"
                                                               FontSize="11" FontAttributes="Bold"
                                                               TextColor="{AppThemeBinding Light={StaticResource PrimaryDeep}, Dark=#93C5FD}"
                                                               VerticalOptions="Center" />
                                                    </HorizontalStackLayout>
                                                </Border>
                                                <Label Text="{Binding RoomName}" FontSize="11"
                                                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                                                       IsVisible="{Binding RoomName, Converter={toolkit:IsNotNullConverter}}"
                                                       VerticalOptions="Center" />
                                                <Label Text="{Binding DurationDisplay}" FontSize="11"
                                                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                                                       VerticalOptions="Center" />
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <!-- Empty State: No live content for today -->
                    <VerticalStackLayout Spacing="12" IsVisible="{Binding ShowEmptyState}"
                                         Padding="32,40" HorizontalOptions="Center">
                        <Image Source="calendar_regular.png" HeightRequest="48" WidthRequest="48"
                               HorizontalOptions="Center" Opacity="0.4"
                               SemanticProperties.Description="">
                            <Image.Behaviors>
                                <toolkit:IconTintColorBehavior TintColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
                            </Image.Behaviors>
                        </Image>
                        <Label Text="{Binding EmptyStateTitle}"
                               FontSize="18" FontAttributes="Bold"
                               HorizontalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
                        <Label Text="{Binding EmptyStateMessage}"
                               FontSize="14"
                               HorizontalTextAlignment="Center"
                               LineBreakMode="WordWrap"
                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
                        <Button Text="Browse Sessions"
                                Command="{Binding NavigateToSessionsCommand}"
                                BackgroundColor="{StaticResource Primary}"
                                TextColor="White"
                                FontAttributes="Bold"
                                CornerRadius="8"
                                Margin="0,8,0,0"
                                HorizontalOptions="Center"
                                Padding="24,12" />
                    </VerticalStackLayout>

                    <!-- Error State: Failed to load data -->
                    <VerticalStackLayout Spacing="12" IsVisible="{Binding HasLoadError}"
                                         Padding="32,40" HorizontalOptions="Center">
                        <Image Source="info_regular.png" HeightRequest="48" WidthRequest="48"
                               HorizontalOptions="Center" Opacity="0.4"
                               SemanticProperties.Description="">
                            <Image.Behaviors>
                                <toolkit:IconTintColorBehavior TintColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
                            </Image.Behaviors>
                        </Image>
                        <Label Text="Couldn't load event data"
                               FontSize="18" FontAttributes="Bold"
                               HorizontalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
                        <Label Text="Check your internet connection and try again."
                               FontSize="14"
                               HorizontalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
                        <Button Text="Retry"
                                Command="{Binding RetryLoadCommand}"
                                BackgroundColor="{StaticResource Primary}"
                                TextColor="White"
                                FontAttributes="Bold"
                                CornerRadius="8"
                                Margin="0,8,0,0"
                                HorizontalOptions="Center"
                                Padding="24,12" />
                    </VerticalStackLayout>

                    <BoxView HeightRequest="100" BackgroundColor="Transparent" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
        </RefreshView>
    </Grid>
</ContentPage>
