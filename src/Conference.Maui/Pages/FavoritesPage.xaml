<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Conference.Maui.ViewModels"
             xmlns:models="clr-namespace:Conference.Maui.Models"
             xmlns:controls="clr-namespace:Conference.Maui.Controls"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             xmlns:behaviors="clr-namespace:Conference.Maui.Behaviors"
             x:Class="Conference.Maui.Pages.FavoritesPage"
             x:DataType="vm:FavoritesViewModel"
             Title="{Binding Title}"
             SafeAreaEdges="None"
             Background="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray950}}">

    <Grid SafeAreaEdges="None">
        <!-- Favorites List -->
        <CollectionView x:Name="FavoritesCollectionView"
                        ItemsSource="{Binding FavoriteSlots}"
                        IsGrouped="True"
                        SelectionMode="Single"
                        SelectionChanged="OnSessionSelected"
                        IsVisible="{Binding HasFavorites}">
            <CollectionView.Behaviors>
                <behaviors:StickyHeaderHapticBehavior />
            </CollectionView.Behaviors>
            <CollectionView.GroupHeaderTemplate>
                <DataTemplate x:DataType="models:TimeSlotGroup">
                    <Grid Background="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}"
                          Padding="12,8"
                          ColumnDefinitions="*,Auto">
                        <Label Text="{Binding TimeDisplay}"
                               FontSize="14"
                               FontAttributes="Bold"
                               SemanticProperties.HeadingLevel="Level2"
                               TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource DarkPrimary}}" />
                        <HorizontalStackLayout Grid.Column="1" Spacing="4" IsVisible="{Binding HasConflict}" VerticalOptions="Center"
                                                   MinimumHeightRequest="44"
                                                   MinimumWidthRequest="44"
                                                   SemanticProperties.Description="Resolve schedule conflicts"
                                                   SemanticProperties.Hint="Double tap to resolve">
                            <HorizontalStackLayout.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnConflictBadgeTapped" />
                            </HorizontalStackLayout.GestureRecognizers>
                            <Image HeightRequest="14" WidthRequest="14" VerticalOptions="Center"
                                   SemanticProperties.Description=""
                                   mi:MauiIcon.Value="{mi:Fluent Icon=Warning24, IconColor={AppThemeBinding Light={StaticResource ConflictOrange}, Dark={StaticResource ConflictOrangeDark}}}" />
                            <Label Text="{Binding ConflictText}"
                                   FontSize="12"
                                   TextColor="{AppThemeBinding Light={StaticResource ConflictOrange}, Dark={StaticResource ConflictOrangeDark}}"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Grid>
                </DataTemplate>
            </CollectionView.GroupHeaderTemplate>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:SessionItem">
                        <controls:SessionCardView />
                    </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.Footer>
                <BoxView HeightRequest="90" BackgroundColor="Transparent" />
            </CollectionView.Footer>
        </CollectionView>

        <!-- Empty State -->
        <VerticalStackLayout VerticalOptions="Center"
                             HorizontalOptions="Center"
                             Padding="32"
                             Spacing="12"
                             IsVisible="{Binding ShowEmptyState}">
            <Image HeightRequest="48" WidthRequest="48" HorizontalOptions="Center"
                   SemanticProperties.Description=""
                   mi:MauiIcon.Value="{mi:Fluent Icon=Star24, IconSize=48, IconColor={AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}}" />
            <Label Text="No sessions in your agenda yet"
                   FontSize="18"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
            <Label Text="Browse sessions and tap the star icon to build your personal schedule."
                   FontSize="14"
                   HorizontalTextAlignment="Center"
                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
        </VerticalStackLayout>

        <!-- Loading Indicator -->
        <ActivityIndicator IsRunning="{Binding IsBusy}"
                           IsVisible="{Binding IsBusy}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           Color="{StaticResource Primary}" />
    </Grid>
</ContentPage>
