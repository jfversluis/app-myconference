<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Conference.Maui.ViewModels"
             xmlns:models="clr-namespace:Conference.Maui.Models"
             xmlns:swipe="clr-namespace:Plugin.Maui.SwipeCardView;assembly=Plugin.Maui.SwipeCardView"
             xmlns:core="clr-namespace:Plugin.Maui.SwipeCardView.Core;assembly=Plugin.Maui.SwipeCardView"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="Conference.Maui.Pages.OnboardingPage"
             x:DataType="vm:OnboardingViewModel"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             NavigationPage.HasNavigationBar="False"
             Background="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray950}}">

    <Grid SafeAreaEdges="None">
        <!-- STEP 0: Welcome with Speaker Photos -->
        <Grid IsVisible="False" x:Name="WelcomeStep" Padding="0" SafeAreaEdges="None">
            <Grid.RowDefinitions>
                <RowDefinition Height="0.55*" />
                <RowDefinition Height="0.45*" />
            </Grid.RowDefinitions>

            <!-- Speaker photos hero area -->
            <Grid Background="{StaticResource HeroGradient}" Padding="0">
                <!-- Scattered circular speaker photos -->
                <AbsoluteLayout x:Name="SpeakerPhotosLayout"
                                IsVisible="{Binding HasFeaturedSpeakers}"
                                HorizontalOptions="Fill" VerticalOptions="Fill">
                    <!-- 1: top-left, large -->
                    <Border StrokeShape="RoundRectangle 55" StrokeThickness="4"
                            HeightRequest="110" WidthRequest="110"
                            AbsoluteLayout.LayoutBounds="0.08,0.08"
                            AbsoluteLayout.LayoutFlags="PositionProportional"
                            x:Name="SpeakerCircle1">
                        <Border.Clip><EllipseGeometry Center="55,55" RadiusX="55" RadiusY="55" /></Border.Clip>
                        <Image x:Name="SpeakerImg1" Aspect="AspectFill" />
                    </Border>

                    <!-- 2: top-right, large -->
                    <Border StrokeShape="RoundRectangle 50" StrokeThickness="4"
                            HeightRequest="100" WidthRequest="100"
                            AbsoluteLayout.LayoutBounds="0.82,0.05"
                            AbsoluteLayout.LayoutFlags="PositionProportional"
                            x:Name="SpeakerCircle2">
                        <Border.Clip><EllipseGeometry Center="50,50" RadiusX="50" RadiusY="50" /></Border.Clip>
                        <Image x:Name="SpeakerImg2" Aspect="AspectFill" />
                    </Border>

                    <!-- 3: mid-left, small -->
                    <Border StrokeShape="RoundRectangle 28" StrokeThickness="3"
                            HeightRequest="56" WidthRequest="56"
                            AbsoluteLayout.LayoutBounds="0.32,0.22"
                            AbsoluteLayout.LayoutFlags="PositionProportional"
                            x:Name="SpeakerCircle3">
                        <Border.Clip><EllipseGeometry Center="28,28" RadiusX="28" RadiusY="28" /></Border.Clip>
                        <Image x:Name="SpeakerImg3" Aspect="AspectFill" />
                    </Border>

                    <!-- 4: center, medium -->
                    <Border StrokeShape="RoundRectangle 42" StrokeThickness="4"
                            HeightRequest="84" WidthRequest="84"
                            AbsoluteLayout.LayoutBounds="0.50,0.38"
                            AbsoluteLayout.LayoutFlags="PositionProportional"
                            x:Name="SpeakerCircle4">
                        <Border.Clip><EllipseGeometry Center="42,42" RadiusX="42" RadiusY="42" /></Border.Clip>
                        <Image x:Name="SpeakerImg4" Aspect="AspectFill" />
                    </Border>

                    <!-- 5: right edge, tiny -->
                    <Border StrokeShape="RoundRectangle 22" StrokeThickness="3"
                            HeightRequest="44" WidthRequest="44"
                            AbsoluteLayout.LayoutBounds="0.92,0.32"
                            AbsoluteLayout.LayoutFlags="PositionProportional"
                            x:Name="SpeakerCircle5">
                        <Border.Clip><EllipseGeometry Center="22,22" RadiusX="22" RadiusY="22" /></Border.Clip>
                        <Image x:Name="SpeakerImg5" Aspect="AspectFill" />
                    </Border>

                    <!-- 6: left, medium-large -->
                    <Border StrokeShape="RoundRectangle 48" StrokeThickness="4"
                            HeightRequest="96" WidthRequest="96"
                            AbsoluteLayout.LayoutBounds="0.05,0.58"
                            AbsoluteLayout.LayoutFlags="PositionProportional"
                            x:Name="SpeakerCircle6">
                        <Border.Clip><EllipseGeometry Center="48,48" RadiusX="48" RadiusY="48" /></Border.Clip>
                        <Image x:Name="SpeakerImg6" Aspect="AspectFill" />
                    </Border>

                    <!-- 7: center-right, small -->
                    <Border StrokeShape="RoundRectangle 30" StrokeThickness="3"
                            HeightRequest="60" WidthRequest="60"
                            AbsoluteLayout.LayoutBounds="0.68,0.55"
                            AbsoluteLayout.LayoutFlags="PositionProportional"
                            x:Name="SpeakerCircle7">
                        <Border.Clip><EllipseGeometry Center="30,30" RadiusX="30" RadiusY="30" /></Border.Clip>
                        <Image x:Name="SpeakerImg7" Aspect="AspectFill" />
                    </Border>

                    <!-- 8: bottom-left, tiny -->
                    <Border StrokeShape="RoundRectangle 24" StrokeThickness="3"
                            HeightRequest="48" WidthRequest="48"
                            AbsoluteLayout.LayoutBounds="0.30,0.75"
                            AbsoluteLayout.LayoutFlags="PositionProportional"
                            x:Name="SpeakerCircle8">
                        <Border.Clip><EllipseGeometry Center="24,24" RadiusX="24" RadiusY="24" /></Border.Clip>
                        <Image x:Name="SpeakerImg8" Aspect="AspectFill" />
                    </Border>

                    <!-- 9: bottom-right, large -->
                    <Border StrokeShape="RoundRectangle 52" StrokeThickness="4"
                            HeightRequest="104" WidthRequest="104"
                            AbsoluteLayout.LayoutBounds="0.85,0.76"
                            AbsoluteLayout.LayoutFlags="PositionProportional"
                            x:Name="SpeakerCircle9">
                        <Border.Clip><EllipseGeometry Center="52,52" RadiusX="52" RadiusY="52" /></Border.Clip>
                        <Image x:Name="SpeakerImg9" Aspect="AspectFill" />
                    </Border>

                    <!-- 10: bottom-center, small -->
                    <Border StrokeShape="RoundRectangle 26" StrokeThickness="3"
                            HeightRequest="52" WidthRequest="52"
                            AbsoluteLayout.LayoutBounds="0.50,0.80"
                            AbsoluteLayout.LayoutFlags="PositionProportional"
                            x:Name="SpeakerCircle10">
                        <Border.Clip><EllipseGeometry Center="26,26" RadiusX="26" RadiusY="26" /></Border.Clip>
                        <Image x:Name="SpeakerImg10" Aspect="AspectFill" />
                    </Border>

                    <!-- 11: top-center, tiny accent -->
                    <Border StrokeShape="RoundRectangle 18" StrokeThickness="2"
                            HeightRequest="36" WidthRequest="36"
                            AbsoluteLayout.LayoutBounds="0.46,0.08"
                            AbsoluteLayout.LayoutFlags="PositionProportional"
                            x:Name="SpeakerCircle11">
                        <Border.Clip><EllipseGeometry Center="18,18" RadiusX="18" RadiusY="18" /></Border.Clip>
                        <Image x:Name="SpeakerImg11" Aspect="AspectFill" />
                    </Border>

                    <!-- 12: upper-right gap filler, medium -->
                    <Border StrokeShape="RoundRectangle 35" StrokeThickness="3"
                            HeightRequest="70" WidthRequest="70"
                            AbsoluteLayout.LayoutBounds="0.68,0.18"
                            AbsoluteLayout.LayoutFlags="PositionProportional"
                            x:Name="SpeakerCircle12">
                        <Border.Clip><EllipseGeometry Center="35,35" RadiusX="35" RadiusY="35" /></Border.Clip>
                        <Image x:Name="SpeakerImg12" Aspect="AspectFill" />
                    </Border>

                    <!-- 13: right mid, tiny -->
                    <Border StrokeShape="RoundRectangle 20" StrokeThickness="2"
                            HeightRequest="40" WidthRequest="40"
                            AbsoluteLayout.LayoutBounds="0.15,0.35"
                            AbsoluteLayout.LayoutFlags="PositionProportional"
                            x:Name="SpeakerCircle13">
                        <Border.Clip><EllipseGeometry Center="20,20" RadiusX="20" RadiusY="20" /></Border.Clip>
                        <Image x:Name="SpeakerImg13" Aspect="AspectFill" />
                    </Border>

                    <!-- 14: center-low, medium -->
                    <Border StrokeShape="RoundRectangle 38" StrokeThickness="3"
                            HeightRequest="76" WidthRequest="76"
                            AbsoluteLayout.LayoutBounds="0.40,0.62"
                            AbsoluteLayout.LayoutFlags="PositionProportional"
                            x:Name="SpeakerCircle14">
                        <Border.Clip><EllipseGeometry Center="38,38" RadiusX="38" RadiusY="38" /></Border.Clip>
                        <Image x:Name="SpeakerImg14" Aspect="AspectFill" />
                    </Border>

                    <!-- 15: bottom-left, tiny -->
                    <Border StrokeShape="RoundRectangle 17" StrokeThickness="2"
                            HeightRequest="34" WidthRequest="34"
                            AbsoluteLayout.LayoutBounds="0.08,0.78"
                            AbsoluteLayout.LayoutFlags="PositionProportional"
                            x:Name="SpeakerCircle15">
                        <Border.Clip><EllipseGeometry Center="17,17" RadiusX="17" RadiusY="17" /></Border.Clip>
                        <Image x:Name="SpeakerImg15" Aspect="AspectFill" />
                    </Border>

                    <!-- 16: lower-right, small -->
                    <Border StrokeShape="RoundRectangle 24" StrokeThickness="3"
                            HeightRequest="48" WidthRequest="48"
                            AbsoluteLayout.LayoutBounds="0.58,0.72"
                            AbsoluteLayout.LayoutFlags="PositionProportional"
                            x:Name="SpeakerCircle16">
                        <Border.Clip><EllipseGeometry Center="24,24" RadiusX="24" RadiusY="24" /></Border.Clip>
                        <Image x:Name="SpeakerImg16" Aspect="AspectFill" />
                    </Border>
                </AbsoluteLayout>

                <!-- Fallback: dotnet_bot when no speakers loaded -->
                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center"
                                     Spacing="8" Padding="32"
                                     IsVisible="False" x:Name="WelcomeFallback">
                    <Image Source="dotnet_bot.png" HeightRequest="120" WidthRequest="120"
                           HorizontalOptions="Center" Opacity="0.95" />
                    <Label Text="MyConference"
                           FontSize="32" FontAttributes="Bold" TextColor="White"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Grid>

            <!-- Content card overlapping hero for smooth transition -->
            <Border Grid.Row="1" Margin="0,-24,0,0"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 24,24,0,0"
                    Background="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray950}}">
                <VerticalStackLayout Spacing="12" Padding="32,32,32,32"
                                     VerticalOptions="Start">
                    <Label Text="Welcome to NDC Copenhagen 2025!"
                           FontSize="24" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray100}}"
                           HorizontalTextAlignment="Center" />

                    <Label Text="95 speakers. 103 sessions. 3 days.&#10;Let's build your perfect schedule."
                           FontSize="15" LineBreakMode="WordWrap"
                           TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}"
                           HorizontalTextAlignment="Center" LineHeight="1.4"
                           Margin="0,0,0,4" />

                    <Button Text="Get Started"
                            Command="{Binding GoToStepCommand}"
                            BackgroundColor="{StaticResource Primary}"
                            TextColor="White"
                            FontSize="16" FontAttributes="Bold"
                            CornerRadius="12" Padding="24,14"
                            HorizontalOptions="Fill">
                        <Button.CommandParameter>
                            <x:Int32>1</x:Int32>
                        </Button.CommandParameter>
                    </Button>

                    <Button Text="Skip, I'll explore myself"
                            Command="{Binding SkipToAppCommand}"
                            BackgroundColor="Transparent"
                            TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                            FontSize="14"
                            HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>

            <Grid Grid.RowSpan="2" IsVisible="{Binding IsBusy}"
                  Background="{AppThemeBinding Light=#80FFFFFF, Dark=#80000000}">
                <ActivityIndicator IsRunning="True" VerticalOptions="Center" HorizontalOptions="Center"
                                   HeightRequest="48" WidthRequest="48" />
            </Grid>
        </Grid>

        <!-- STEP 1: Notification Permission -->
        <Grid IsVisible="False" x:Name="NotificationStep" Padding="0" SafeAreaEdges="None">
            <Grid.RowDefinitions>
                <RowDefinition Height="0.4*" />
                <RowDefinition Height="0.6*" />
            </Grid.RowDefinitions>

            <Grid Background="{StaticResource HeroGradient}">
                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="16" Padding="32">
                    <Label Text="🔔" FontSize="56" HorizontalTextAlignment="Center" />
                    <Label Text="Stay in the loop"
                           FontSize="28" FontAttributes="Bold" TextColor="White"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Grid>

            <Border Grid.Row="1" Margin="0,-24,0,0"
                    StrokeShape="RoundRectangle 24,24,0,0"
                    StrokeThickness="0"
                    BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray950}}">
                <VerticalStackLayout Spacing="16" Padding="32,32"
                                     VerticalOptions="Start">
                    <Label Text="Get reminders before your sessions start so you never miss a talk."
                           FontSize="16"
                           TextColor="{AppThemeBinding Light={StaticResource Gray700}, Dark={StaticResource Gray300}}"
                           HorizontalTextAlignment="Center"
                           LineBreakMode="WordWrap" LineHeight="1.4" />

                    <Label Text="We'll only notify you about sessions on your agenda — nothing else."
                           FontSize="14"
                           TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                           HorizontalTextAlignment="Center"
                           LineBreakMode="WordWrap"
                           Margin="0,0,0,8" />

                    <Button Text="Enable Notifications"
                            Command="{Binding RequestNotificationPermissionCommand}"
                            BackgroundColor="{StaticResource Primary}"
                            TextColor="White"
                            FontSize="16" FontAttributes="Bold"
                            CornerRadius="12" Padding="24,14"
                            HorizontalOptions="Fill"
                            IsVisible="{Binding NotificationPermissionRequested, Converter={toolkit:InvertedBoolConverter}}" />

                    <!-- Show after permission is requested -->
                    <VerticalStackLayout IsVisible="{Binding NotificationPermissionRequested}" Spacing="8">
                        <Label Text="✅ Notifications enabled — you're all set!"
                               IsVisible="{Binding NotificationsGranted}"
                               FontSize="15" FontAttributes="Bold"
                               TextColor="{StaticResource Primary}"
                               HorizontalTextAlignment="Center" />
                        <Label Text="No worries — you can enable notifications later in Settings."
                               IsVisible="{Binding NotificationsGranted, Converter={toolkit:InvertedBoolConverter}}"
                               FontSize="14"
                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>

                    <Button Text="Continue"
                            Command="{Binding GoToStepCommand}"
                            BackgroundColor="{StaticResource Primary}"
                            TextColor="White"
                            FontSize="16" FontAttributes="Bold"
                            CornerRadius="12" Padding="24,14"
                            HorizontalOptions="Fill"
                            IsVisible="{Binding NotificationPermissionRequested}">
                        <Button.CommandParameter>
                            <x:Int32>2</x:Int32>
                        </Button.CommandParameter>
                    </Button>

                    <Button Text="Not now"
                            Command="{Binding GoToStepCommand}"
                            BackgroundColor="Transparent"
                            TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                            FontSize="14"
                            HorizontalOptions="Center">
                        <Button.CommandParameter>
                            <x:Int32>2</x:Int32>
                        </Button.CommandParameter>
                    </Button>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- STEP 1: Pick Interests -->
        <Grid IsVisible="False" x:Name="InterestsStep" RowDefinitions="Auto,*,Auto" Padding="0">
            <VerticalStackLayout Padding="24,48,24,16" Spacing="8"
                                 Background="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray950}}">
                <Label Text="What interests you?"
                       FontSize="24" FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray100}}" />
                <Label Text="Pick your topics and we'll recommend sessions just for you."
                       FontSize="14"
                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
            </VerticalStackLayout>

            <ScrollView Grid.Row="1" Padding="24,8">
                <FlexLayout BindableLayout.ItemsSource="{Binding AvailableTags}"
                            Wrap="Wrap" Direction="Row"
                            JustifyContent="Start" AlignItems="Start"
                            AlignContent="Start">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:InterestTag">
                            <Border Margin="0,0,8,10"
                                    StrokeShape="RoundRectangle 20"
                                    StrokeThickness="1.5"
                                    Padding="16,10"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                        <Setter Property="Stroke" Value="{StaticResource Primary}" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="False">
                                        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:OnboardingViewModel}}, Path=ToggleTagCommand}"
                                                          CommandParameter="{Binding}" />
                                </Border.GestureRecognizers>
                                <HorizontalStackLayout Spacing="6">
                                    <Label Text="{Binding Name}" FontSize="14" FontAttributes="Bold"
                                           VerticalOptions="Center">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="TextColor" Value="White" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="False">
                                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray700}, Dark={StaticResource Gray300}}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                    <Label Text="{Binding SessionCount, StringFormat='({0})'}" FontSize="12"
                                           VerticalOptions="Center">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="TextColor" Value="#CCFFFFFF" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="False">
                                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </HorizontalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>
            </ScrollView>

            <Grid Grid.Row="2" Padding="24,12,24,32" ColumnDefinitions="*,*" ColumnSpacing="12"
                  Background="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray950}}">
                <Button Text="Skip this step"
                        Command="{Binding StartQuickPickCommand}"
                        BackgroundColor="Transparent"
                        TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                        FontSize="14" />
                <Button Grid.Column="1"
                        Text="{Binding SelectedTagCount, StringFormat='Continue ({0} selected)'}"
                        Command="{Binding StartQuickPickCommand}"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="White"
                        FontSize="14" FontAttributes="Bold"
                        CornerRadius="12" />
            </Grid>
        </Grid>

        <!-- STEP 3: Quick Pick -->
        <Grid IsVisible="False" x:Name="QuickPickStep"
              RowDefinitions="Auto,*,Auto" Padding="0"
              Background="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray950}}"
              SafeAreaEdges="Container">

            <Grid Grid.Row="0" Padding="20,48,20,8" RowDefinitions="Auto,Auto" RowSpacing="6">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="{Binding RemainingText}"
                           FontSize="16" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource Gray800}, Dark={StaticResource Gray200}}"
                           VerticalOptions="Center" />
                    <Button Grid.Column="1" Text="Done"
                            Command="{Binding FinishQuickPickCommand}"
                            BackgroundColor="Transparent"
                            TextColor="{StaticResource Primary}"
                            FontSize="14" FontAttributes="Bold"
                            Padding="8,4" />
                </Grid>
                <ProgressBar Grid.Row="1"
                             Progress="{Binding QuickPickProgress}"
                             ProgressColor="{StaticResource Primary}"
                             HeightRequest="3" />
            </Grid>

            <Grid Grid.Row="1" Padding="16,0">
                <swipe:SwipeCardView x:Name="OnboardingSwipeCards"
                                     ItemsSource="{Binding Cards}"
                                     Threshold="100"
                                     SupportedSwipeDirections="Left,Right"
                                     SupportedDraggingDirections="Left,Right"
                                     AnimationLength="200"
                                     CardRotation="8"
                                     BackCardScale="0.97"
                                     Margin="0,4"
                                     Swiped="OnSwiped"
                                     Dragging="OnDragging">
                    <swipe:SwipeCardView.ItemTemplate>
                        <DataTemplate x:DataType="models:SessionItem">
                            <Grid>
                                <!-- Main card -->
                                <Border StrokeShape="RoundRectangle 16"
                                        Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
                                        StrokeThickness="0.5"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}"
                                        Padding="0" Margin="8">
                                    <Border.Shadow>
                                        <Shadow Brush="{AppThemeBinding Light=#20000000, Dark=#40000000}"
                                                Offset="0,8" Radius="24" Opacity="0.7" />
                                    </Border.Shadow>
                                    <Grid RowDefinitions="Auto,Auto,Auto,*">
                                        <!-- Speaker strip -->
                                        <HorizontalStackLayout Grid.Row="0" Spacing="8" Padding="24,22,24,0"
                                                                IsVisible="{Binding HasSpeaker1}">
                                            <Border StrokeShape="RoundRectangle 16" StrokeThickness="0"
                                                    HeightRequest="32" WidthRequest="32">
                                                <Image Source="{Binding Speaker1.ProfilePictureUrl}"
                                                       Aspect="AspectFill" />
                                            </Border>
                                            <VerticalStackLayout Spacing="0" VerticalOptions="Center">
                                                <Label Text="{Binding SpeakerNames}" FontSize="13" FontAttributes="Bold"
                                                       TextColor="{AppThemeBinding Light={StaticResource Gray700}, Dark={StaticResource Gray300}}"
                                                       LineBreakMode="TailTruncation" MaxLines="1" />
                                                <Label Text="{Binding Speaker1.TagLine}" FontSize="11"
                                                       TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}"
                                                       LineBreakMode="TailTruncation" MaxLines="1"
                                                       IsVisible="{Binding Speaker1.TagLine, Converter={toolkit:IsNotNullConverter}}" />
                                            </VerticalStackLayout>
                                        </HorizontalStackLayout>

                                        <!-- Metadata -->
                                        <HorizontalStackLayout Grid.Row="1" Padding="24,8,24,0" Spacing="6">
                                            <Image Source="clock_regular.png" HeightRequest="14" WidthRequest="14"
                                                   VerticalOptions="Center" />
                                            <Label Text="{Binding TimeDisplay}" FontSize="13"
                                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                                                   VerticalOptions="Center" />
                                            <Label Text="·" FontSize="13"
                                                   TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}"
                                                   IsVisible="{Binding RoomName, Converter={toolkit:IsNotNullConverter}}" />
                                            <Image Source="location_regular.png" HeightRequest="14" WidthRequest="14"
                                                   VerticalOptions="Center"
                                                   IsVisible="{Binding RoomName, Converter={toolkit:IsNotNullConverter}}" />
                                            <Label Text="{Binding RoomName}" FontSize="13"
                                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                                                   VerticalOptions="Center"
                                                   IsVisible="{Binding RoomName, Converter={toolkit:IsNotNullConverter}}" />
                                        </HorizontalStackLayout>

                                        <!-- Title -->
                                        <Label Grid.Row="2" Text="{Binding Title}" FontSize="20" FontAttributes="Bold"
                                               MaxLines="3" LineBreakMode="TailTruncation"
                                               Padding="24,12,24,0"
                                               TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray100}}" />

                                        <!-- Description -->
                                        <Label Grid.Row="3" Text="{Binding Description}" FontSize="13"
                                               MaxLines="4" LineBreakMode="TailTruncation"
                                               Padding="24,10,24,16"
                                               TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}"
                                               LineHeight="1.4" />

                                    </Grid>
                                </Border>

                                <!-- Add overlay — subtle purple tint -->
                                <Border x:Name="LikeFrame"
                                        StrokeShape="RoundRectangle 12"
                                        Stroke="{StaticResource Primary}" StrokeThickness="3"
                                        BackgroundColor="#15512BD4"
                                        HorizontalOptions="Start" VerticalOptions="Start"
                                        Margin="36,48" Rotation="-12" Opacity="0"
                                        Padding="14,6"
                                        InputTransparent="True">
                                    <Label Text="ADD" TextColor="{StaticResource Primary}" FontSize="24" FontAttributes="Bold"
                                           CharacterSpacing="2" />
                                </Border>

                                <!-- Skip overlay — quiet grey -->
                                <Border x:Name="NopeFrame"
                                        StrokeShape="RoundRectangle 12"
                                        Stroke="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}"
                                        StrokeThickness="3"
                                        BackgroundColor="{AppThemeBinding Light=#10000000, Dark=#15FFFFFF}"
                                        HorizontalOptions="End" VerticalOptions="Start"
                                        Margin="36,48" Rotation="12" Opacity="0"
                                        Padding="14,6"
                                        InputTransparent="True">
                                    <Label Text="SKIP"
                                           TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                                           FontSize="24" FontAttributes="Bold"
                                           CharacterSpacing="2" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </swipe:SwipeCardView.ItemTemplate>
                </swipe:SwipeCardView>

            </Grid>

            <Grid x:Name="QuickPickBottomBar" Grid.Row="2" Padding="20,8,20,32" ColumnDefinitions="Auto,*,Auto">
                <!-- Skip button -->
                <Border x:Name="OnboardingSkipButton"
                        StrokeShape="RoundRectangle 28"
                        StrokeThickness="1.5"
                        Stroke="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"
                        BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}"
                        HeightRequest="56" WidthRequest="56"
                        HorizontalOptions="Center" VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnQuickPickSkipTapped" />
                    </Border.GestureRecognizers>
                    <Image Source="{mi:Fluent Icon=Dismiss24, IconColor={AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}}"
                           HeightRequest="24" WidthRequest="24"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>

                <!-- Undo button -->
                <Border Grid.Column="1"
                        StrokeShape="RoundRectangle 22"
                        StrokeThickness="0"
                        BackgroundColor="Transparent"
                        HeightRequest="44" WidthRequest="44"
                        HorizontalOptions="Center" VerticalOptions="Center"
                        Opacity="{Binding ShowUndo, Converter={toolkit:BoolToObjectConverter TrueObject=1, FalseObject=0.3}}"
                        InputTransparent="{Binding ShowUndo, Converter={toolkit:InvertedBoolConverter}}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnQuickPickUndoTapped" />
                    </Border.GestureRecognizers>
                    <Image Source="{mi:Fluent Icon=ArrowUndo24, IconColor={StaticResource Primary}}"
                           HeightRequest="22" WidthRequest="22"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>

                <!-- Add button -->
                <Border x:Name="OnboardingAddButton"
                        Grid.Column="2"
                        StrokeShape="RoundRectangle 28"
                        StrokeThickness="1.5"
                        Stroke="{StaticResource Primary}"
                        BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}"
                        HeightRequest="56" WidthRequest="56"
                        HorizontalOptions="Center" VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnQuickPickAddTapped" />
                    </Border.GestureRecognizers>
                    <Image Source="{mi:Fluent Icon=Heart24, IconColor={StaticResource Primary}}"
                           HeightRequest="24" WidthRequest="24"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
            </Grid>
        </Grid>

        <!-- STEP 4: Done / Celebration -->
        <Grid IsVisible="False" x:Name="DoneStep" Padding="0" SafeAreaEdges="None">
            <Grid.RowDefinitions>
                <RowDefinition Height="0.4*" />
                <RowDefinition Height="0.6*" />
            </Grid.RowDefinitions>

            <Grid Background="{StaticResource HeroGradient}">
                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="16" Padding="32">
                    <Label Text="🎉" FontSize="56" HorizontalTextAlignment="Center" />
                    <Label Text="You're all set!"
                           FontSize="28" FontAttributes="Bold" TextColor="White"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Grid>

            <Border Grid.Row="1" Margin="0,-24,0,0"
                    StrokeShape="RoundRectangle 24,24,0,0"
                    StrokeThickness="0"
                    BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray950}}">
                <VerticalStackLayout Spacing="16" Padding="32,32"
                                     VerticalOptions="Start">
                    <Label x:Name="SummaryLabel"
                           FontSize="16"
                           TextColor="{AppThemeBinding Light={StaticResource Gray700}, Dark={StaticResource Gray300}}"
                           HorizontalTextAlignment="Center"
                           LineBreakMode="WordWrap" />

                    <Label Text="Your personalized agenda is ready. You can always add more sessions from the Sessions tab or try Quick Pick for more discoveries."
                           FontSize="14"
                           TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                           HorizontalTextAlignment="Center"
                           LineBreakMode="WordWrap"
                           Margin="0,0,0,8" />

                    <Button Text="View My Agenda"
                            Clicked="OnViewAgendaClicked"
                            BackgroundColor="{StaticResource Primary}"
                            TextColor="White"
                            FontSize="16" FontAttributes="Bold"
                            CornerRadius="12" Padding="24,14"
                            HorizontalOptions="Fill" />

                    <Button Text="Explore the app"
                            Command="{Binding FinishOnboardingCommand}"
                            BackgroundColor="Transparent"
                            TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                            FontSize="14"
                            HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
