<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Conference.Maui.ViewModels"
             xmlns:models="clr-namespace:Conference.Maui.Models"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             x:Class="Conference.Maui.Pages.AboutPage"
             x:DataType="vm:AboutViewModel"
             Title="{Binding Title}"
             SafeAreaEdges="None"
             Background="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray950}}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Settings"
                     IconImageSource="settings_regular.png"
                     Command="{Binding NavigateToSettingsCommand}"
                     Order="Primary" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Spacing="0">

            <!-- Hero Header -->
            <Grid Padding="20,16" Background="{StaticResource HeroGradient}" RowDefinitions="Auto,Auto,Auto">
                <Label Grid.Row="0"
                       Text="{Binding ConferenceName}"
                       FontSize="26"
                       FontAttributes="Bold"
                       TextColor="White"
                       HorizontalTextAlignment="Center" />
                <Label Grid.Row="1"
                       Text="{Binding EventDateRange}"
                       FontSize="15"
                       TextColor="White"
                       Opacity="0.9"
                       HorizontalTextAlignment="Center"
                       Margin="0,6,0,0" />
                <Button Grid.Row="2"
                        Text="Visit Website"
                        Command="{Binding OpenConferenceWebsiteCommand}"
                        BackgroundColor="White"
                        TextColor="{StaticResource Primary}"
                        CornerRadius="10"
                        FontAttributes="Bold"
                        FontSize="14"
                        HeightRequest="44"
                        Margin="40,16,40,0"
                        mi:MauiIcon.Value="{mi:Fluent Icon=Open16, IconColor={StaticResource Primary}}" />
            </Grid>

            <!-- Content -->
            <VerticalStackLayout Spacing="20" Padding="16,20">

                <!-- About the Event -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="ABOUT THE EVENT"
                           FontSize="11"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}"
                           CharacterSpacing="0.5" />
                    <Label Text="{Binding EventDescription}"
                           FontSize="15"
                           LineHeight="1.5"
                           LineBreakMode="WordWrap"
                           TextColor="{AppThemeBinding Light={StaticResource Gray800}, Dark={StaticResource Gray200}}" />
                </VerticalStackLayout>

                <!-- Venue Info -->
                <Border x:Name="VenueCard"
                        StrokeShape="RoundRectangle 12"
                        Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                        StrokeThickness="1"
                        Background="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}"
                        Padding="16">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Image Grid.Column="0" HeightRequest="24" WidthRequest="24" VerticalOptions="Center"
                               mi:MauiIcon.Value="{mi:Fluent Icon=Location24, IconColor={StaticResource Primary}}" />
                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="{Binding VenueName}"
                                   FontSize="16"
                                   FontAttributes="Bold" />
                            <Label Text="{Binding VenueDetails}"
                                   FontSize="13"
                                   LineHeight="1.4"
                                   LineBreakMode="WordWrap"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
                        </VerticalStackLayout>
                        <Image Grid.Column="2" HeightRequest="16" WidthRequest="16" VerticalOptions="Center"
                               IsVisible="{Binding IsPhysicalVenue}"
                               mi:MauiIcon.Value="{mi:Fluent Icon=ChevronRight20, IconColor={StaticResource Gray400}}" />
                    </Grid>
                </Border>

                <!-- WiFi Info (only shown when configured) -->
                <Border StrokeShape="RoundRectangle 12"
                        Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                        StrokeThickness="1"
                        Background="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}"
                        Padding="16"
                        IsVisible="{Binding HasWifi}">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Image Grid.Column="0" Source="wifi_regular.png"
                               HeightRequest="24" WidthRequest="24"
                               VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="{Binding WifiNetworkName}"
                                   FontSize="15"
                                   FontAttributes="Bold" />
                            <Label Text="{Binding WifiPassword, StringFormat='Password: {0}'}"
                                   FontSize="13"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
                        </VerticalStackLayout>
                        <Button Grid.Column="2"
                                Text="Connect"
                                Command="{Binding ConnectToWifiCommand}"
                                BackgroundColor="{StaticResource Primary}"
                                TextColor="White"
                                FontSize="12"
                                FontAttributes="Bold"
                                CornerRadius="8"
                                Padding="12,6"
                                VerticalOptions="Center" />
                    </Grid>
                </Border>

                <!-- Sponsors Section -->
                <VerticalStackLayout Spacing="10">
                    <Label Text="OUR SPONSORS"
                           FontSize="11"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}"
                           CharacterSpacing="0.5" />
                    <Label Text="Thank you to our amazing sponsors who make this event possible!"
                           FontSize="13"
                           TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />

                    <FlexLayout x:Name="SponsorsLayout"
                                Wrap="Wrap"
                                JustifyContent="SpaceEvenly"
                                AlignItems="Center" />
                </VerticalStackLayout>

                <!-- Built With Section -->
                <VerticalStackLayout Spacing="10">
                    <Label Text="BUILT WITH"
                           FontSize="11"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}"
                           CharacterSpacing="0.5" />

                    <!-- Powered by Sessionize -->
                    <Border StrokeShape="RoundRectangle 12"
                            Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                            StrokeThickness="1"
                            Background="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}"
                            Padding="14">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenSessionizeCommand}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Image Grid.Column="0" HeightRequest="22" WidthRequest="22" VerticalOptions="Center"
                                   mi:MauiIcon.Value="{mi:Fluent Icon=Database20, IconColor={StaticResource Primary}}" />
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="Powered by Sessionize"
                                       FontSize="15"
                                       FontAttributes="Bold" />
                                <Label Text="Conference data provided by the Sessionize API"
                                       FontSize="12"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
                            </VerticalStackLayout>
                            <Image Grid.Column="2" HeightRequest="16" WidthRequest="16" VerticalOptions="Center"
                                   mi:MauiIcon.Value="{mi:Fluent Icon=Open16, IconColor={StaticResource Gray400}}" />
                        </Grid>
                    </Border>

                    <!-- Key Libraries -->
                    <Border StrokeShape="RoundRectangle 12"
                            Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                            StrokeThickness="1"
                            Background="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}"
                            Padding="14">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="Key libraries and frameworks"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}" />
                            <Label Text="• .NET MAUI — Cross-platform app framework&#10;• CommunityToolkit.Mvvm — MVVM source generators&#10;• Akavache — Reactive offline caching&#10;• Sessionize.Api.Client — Conference data API&#10;• AathifMahir.Maui.MauiIcons — Fluent icon system&#10;• Plugin.LocalNotification — Session reminders"
                                   FontSize="13"
                                   LineHeight="1.6"
                                   LineBreakMode="WordWrap"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray700}, Dark={StaticResource Gray300}}" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- Source Code -->
                <Border StrokeShape="RoundRectangle 12"
                        Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                        StrokeThickness="1"
                        Background="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}"
                        Padding="14">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenSourceCodeCommand}" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Image Grid.Column="0" HeightRequest="22" WidthRequest="22" VerticalOptions="Center"
                               mi:MauiIcon.Value="{mi:Fluent Icon=Code20, IconColor={StaticResource Primary}}" />
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="View Source Code"
                                   FontSize="15"
                                   FontAttributes="Bold" />
                            <Label Text="This app is open source on GitHub"
                                   FontSize="12"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
                        </VerticalStackLayout>
                        <Image Grid.Column="2" HeightRequest="16" WidthRequest="16" VerticalOptions="Center"
                               mi:MauiIcon.Value="{mi:Fluent Icon=Open16, IconColor={StaticResource Gray400}}" />
                    </Grid>
                </Border>

                <!-- App Version -->
                <Label Text="{Binding AppVersion}"
                       FontSize="12"
                       HorizontalTextAlignment="Center"
                       TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}"
                       Margin="0,4,0,0" />

                <BoxView HeightRequest="120" BackgroundColor="Transparent" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
