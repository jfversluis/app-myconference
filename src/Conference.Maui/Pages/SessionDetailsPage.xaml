<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Conference.Maui.ViewModels"
             xmlns:models="clr-namespace:Conference.Maui.Models"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="Conference.Maui.Pages.SessionDetailsPage"
             x:DataType="vm:SessionDetailsViewModel"
             Title="Session">

    <ScrollView>
        <VerticalStackLayout Spacing="0">
            
            <!-- Header Section with gradient background -->
            <Grid Padding="20,24" 
                  Background="{StaticResource Primary}">
                <VerticalStackLayout Spacing="12">
                    <!-- Session Title -->
                    <Label Text="{Binding Session.Title}"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="White"
                           LineBreakMode="WordWrap" />

                    <!-- Meta info row -->
                    <HorizontalStackLayout Spacing="16">
                        <!-- Date -->
                        <HorizontalStackLayout Spacing="6">
                            <Label Text="📅"
                                   FontSize="14"
                                   VerticalOptions="Center" />
                            <Label Text="{Binding Session.StartsAt, StringFormat='{0:ddd, MMM d}'}"
                                   FontSize="13"
                                   TextColor="White"
                                   Opacity="0.9"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        
                        <!-- Time -->
                        <HorizontalStackLayout Spacing="6">
                            <Label Text="⏱"
                                   FontSize="14"
                                   VerticalOptions="Center" />
                            <Label Text="{Binding Session.DurationDisplay}"
                                   FontSize="13"
                                   TextColor="White"
                                   Opacity="0.9"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </HorizontalStackLayout>

                    <!-- Room chip -->
                    <Border Background="Transparent"
                            Stroke="White"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 16"
                            Padding="12,6"
                            HorizontalOptions="Start"
                            IsVisible="{Binding Session.RoomName, Converter={toolkit:IsNotNullConverter}}">
                        <HorizontalStackLayout Spacing="6">
                            <Label Text="📍"
                                   FontSize="12"
                                   VerticalOptions="Center" />
                            <Label Text="{Binding Session.RoomName}"
                                   FontSize="13"
                                   TextColor="White"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </Grid>

            <!-- Content Section -->
            <VerticalStackLayout Padding="20,20" Spacing="20"
                                 Background="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray950}}">
                
                <!-- Time Display -->
                <HorizontalStackLayout Spacing="8">
                    <Label Text="🕐"
                           FontSize="18"
                           VerticalOptions="Center" />
                    <Label Text="{Binding Session.TimeDisplay}"
                           FontSize="16"
                           FontAttributes="Bold"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>

                <!-- Favorite Button -->
                <Button Text="{Binding Session.IsFavorite, Converter={toolkit:BoolToObjectConverter TrueObject='★ Added to My Agenda', FalseObject='☆ Add to My Agenda'}}"
                        Command="{Binding ToggleFavoriteCommand}"
                        BackgroundColor="{Binding Session.IsFavorite, Converter={toolkit:BoolToObjectConverter TrueObject={StaticResource Primary}, FalseObject=Transparent}}"
                        TextColor="{Binding Session.IsFavorite, Converter={toolkit:BoolToObjectConverter TrueObject=White, FalseObject={StaticResource Primary}}}"
                        BorderColor="{StaticResource Primary}"
                        BorderWidth="2"
                        CornerRadius="12"
                        FontAttributes="Bold"
                        HeightRequest="48" />

                <!-- Description Section -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="About"
                           FontSize="13"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                           TextTransform="Uppercase" />
                    <Label Text="{Binding Session.Description}"
                           FontSize="15"
                           LineHeight="1.4"
                           LineBreakMode="WordWrap"
                           TextColor="{AppThemeBinding Light={StaticResource Gray700}, Dark={StaticResource Gray200}}" />
                </VerticalStackLayout>

                <!-- Speakers Section -->
                <VerticalStackLayout Spacing="12" IsVisible="{Binding Session.HasSpeaker1}">
                    <Label Text="Speakers"
                           FontSize="13"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                           TextTransform="Uppercase" />

                    <CollectionView ItemsSource="{Binding Session.Speakers}"
                                    SelectionMode="None">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:SpeakerItem">
                                <Border Background="{AppThemeBinding Light={StaticResource Gray50}, Dark={StaticResource Gray900}}"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 16"
                                        Padding="14">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer 
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SessionDetailsViewModel}}, Path=NavigateToSpeakerCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="52,*,Auto" ColumnSpacing="14">
                                        <!-- Speaker Avatar -->
                                        <Grid Grid.Column="0"
                                              HeightRequest="52"
                                              WidthRequest="52">
                                            <!-- Fallback initials -->
                                            <Border Background="{StaticResource Primary}"
                                                    StrokeThickness="0"
                                                    StrokeShape="RoundRectangle 26"
                                                    HeightRequest="52"
                                                    WidthRequest="52">
                                                <Label Text="{Binding Initials}"
                                                       TextColor="White"
                                                       FontSize="16"
                                                       FontAttributes="Bold"
                                                       HorizontalOptions="Center"
                                                       VerticalOptions="Center" />
                                            </Border>
                                            <!-- Actual image -->
                                            <Image Source="{Binding ProfilePictureUrl}"
                                                   Aspect="AspectFill"
                                                   HeightRequest="52"
                                                   WidthRequest="52">
                                                <Image.Clip>
                                                    <EllipseGeometry Center="26,26" RadiusX="26" RadiusY="26" />
                                                </Image.Clip>
                                            </Image>
                                        </Grid>

                                        <!-- Speaker Info -->
                                        <VerticalStackLayout Grid.Column="1" 
                                                             VerticalOptions="Center"
                                                             Spacing="2">
                                            <Label Text="{Binding FullName}"
                                                   FontSize="15"
                                                   FontAttributes="Bold"
                                                   LineBreakMode="TailTruncation" />
                                            <Label Text="{Binding TagLine}"
                                                   FontSize="13"
                                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                                                   LineBreakMode="TailTruncation"
                                                   MaxLines="2" />
                                        </VerticalStackLayout>

                                        <!-- Chevron -->
                                        <Label Grid.Column="2"
                                               Text="›"
                                               FontSize="22"
                                               TextColor="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"
                                               VerticalOptions="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <!-- Bottom padding for safe area -->
                <BoxView HeightRequest="40" BackgroundColor="Transparent" />
                
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
