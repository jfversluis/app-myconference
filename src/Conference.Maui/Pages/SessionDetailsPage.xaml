<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Conference.Maui.ViewModels"
             xmlns:models="clr-namespace:Conference.Maui.Models"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="Conference.Maui.Pages.SessionDetailsPage"
             x:DataType="vm:SessionDetailsViewModel"
             Title="Session"
             SafeAreaEdges="None"
             x:Name="ThisPage">

    <Grid SafeAreaEdges="None">
        <!-- Loading State -->
        <VerticalStackLayout IsVisible="{Binding IsBusy}"
                             VerticalOptions="Center"
                             HorizontalOptions="Center"
                             Spacing="12">
            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               Color="{StaticResource Primary}"
                               HeightRequest="40"
                               WidthRequest="40" />
            <Label Text="Loading session..."
                   FontSize="14"
                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                   HorizontalOptions="Center" />
        </VerticalStackLayout>

        <!-- Content (hidden while loading) -->
        <ScrollView IsVisible="{Binding IsBusy, Converter={toolkit:InvertedBoolConverter}}">
            <VerticalStackLayout Spacing="0">
                
                <!-- Compact Header Section -->
                <Grid Padding="16,16,16,14" 
                      Background="{StaticResource Primary}"
                      IsVisible="{Binding Session, Converter={toolkit:IsNotNullConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Row 0: Title -->
                    <Label Grid.Row="0"
                           Text="{Binding Session.Title}"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="White"
                           LineBreakMode="WordWrap"
                           Margin="0,0,0,10" />

                    <!-- Row 1: Meta info with icons -->
                    <HorizontalStackLayout Grid.Row="1" Spacing="16" Margin="0,0,0,10">
                        <!-- Date & Time -->
                        <HorizontalStackLayout Spacing="5">
                            <Image Source="calendar_regular.png" 
                                   HeightRequest="14" 
                                   WidthRequest="14"
                                   VerticalOptions="Center">
                                <Image.Behaviors>
                                    <toolkit:IconTintColorBehavior TintColor="White" />
                                </Image.Behaviors>
                            </Image>
                            <Label Text="{Binding Session.StartsAt, StringFormat='{0:ddd d MMM}'}"
                                   FontSize="12"
                                   TextColor="White"
                                   Opacity="0.9"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        
                        <!-- Time -->
                        <HorizontalStackLayout Spacing="5">
                            <Image Source="clock_regular.png" 
                                   HeightRequest="14" 
                                   WidthRequest="14"
                                   VerticalOptions="Center">
                                <Image.Behaviors>
                                    <toolkit:IconTintColorBehavior TintColor="White" />
                                </Image.Behaviors>
                            </Image>
                            <Label Text="{Binding Session.TimeDisplay}"
                                   FontSize="12"
                                   TextColor="White"
                                   Opacity="0.9"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        
                        <!-- Duration -->
                        <Label Text="{Binding Session.DurationDisplay, StringFormat='({0})'}"
                               FontSize="12"
                               TextColor="White"
                               Opacity="0.7"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <!-- Row 2: Room and Speaker Avatars -->
                    <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
                        <!-- Room -->
                        <HorizontalStackLayout Grid.Column="0" 
                                               Spacing="5"
                                               VerticalOptions="Center"
                                               IsVisible="{Binding Session.RoomName, Converter={toolkit:IsNotNullConverter}}">
                            <Image Source="location_regular.png" 
                                   HeightRequest="14" 
                                   WidthRequest="14"
                                   VerticalOptions="Center">
                                <Image.Behaviors>
                                    <toolkit:IconTintColorBehavior TintColor="White" />
                                </Image.Behaviors>
                            </Image>
                            <Label Text="{Binding Session.RoomName}"
                                   FontSize="12"
                                   TextColor="White"
                                   Opacity="0.9"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>

                        <!-- Overlapping Speaker Avatars -->
                        <HorizontalStackLayout Grid.Column="1" 
                                               VerticalOptions="Center"
                                               IsVisible="{Binding Session.HasSpeaker1}">
                            <!-- Speaker 1 -->
                            <Border StrokeShape="RoundRectangle 16"
                                    HeightRequest="32"
                                    WidthRequest="32"
                                    StrokeThickness="2"
                                    Stroke="White"
                                    Background="{StaticResource Primary}"
                                    IsVisible="{Binding Session.HasSpeaker1}">
                                <Image Source="{Binding Session.Speaker1.ProfilePictureUrl}"
                                       Aspect="AspectFill" />
                            </Border>
                            <!-- Speaker 2 -->
                            <Border StrokeShape="RoundRectangle 16"
                                    HeightRequest="32"
                                    WidthRequest="32"
                                    StrokeThickness="2"
                                    Stroke="White"
                                    Background="{StaticResource Primary}"
                                    Margin="-12,0,0,0"
                                    IsVisible="{Binding Session.HasSpeaker2}">
                                <Image Source="{Binding Session.Speaker2.ProfilePictureUrl}"
                                       Aspect="AspectFill" />
                            </Border>
                            <!-- Speaker 3 -->
                            <Border StrokeShape="RoundRectangle 16"
                                    HeightRequest="32"
                                    WidthRequest="32"
                                    StrokeThickness="2"
                                    Stroke="White"
                                    Background="{StaticResource Primary}"
                                    Margin="-12,0,0,0"
                                    IsVisible="{Binding Session.HasSpeaker3}">
                                <Image Source="{Binding Session.Speaker3.ProfilePictureUrl}"
                                       Aspect="AspectFill" />
                            </Border>
                            <!-- Speaker 4 -->
                            <Border StrokeShape="RoundRectangle 16"
                                    HeightRequest="32"
                                    WidthRequest="32"
                                    StrokeThickness="2"
                                    Stroke="White"
                                    Background="{StaticResource Primary}"
                                    Margin="-12,0,0,0"
                                    IsVisible="{Binding Session.HasSpeaker4}">
                                <Image Source="{Binding Session.Speaker4.ProfilePictureUrl}"
                                       Aspect="AspectFill" />
                            </Border>
                            <!-- More speakers indicator -->
                            <Border StrokeShape="RoundRectangle 16"
                                    HeightRequest="32"
                                    WidthRequest="32"
                                    StrokeThickness="2"
                                    Stroke="White"
                                    Background="{StaticResource PrimaryDark}"
                                    Margin="-12,0,0,0"
                                    IsVisible="{Binding Session.HasMoreSpeakers}">
                                <Label Text="{Binding Session.MoreSpeakersText}"
                                       FontSize="10"
                                       FontAttributes="Bold"
                                       TextColor="White"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                        </HorizontalStackLayout>
                    </Grid>
                </Grid>

                <!-- Content Section -->
                <VerticalStackLayout Padding="16,16" Spacing="16"
                                     Background="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray950}}"
                                     IsVisible="{Binding Session, Converter={toolkit:IsNotNullConverter}}">
                    
                    <!-- Favorite Button -->
                    <Button Text="{Binding Session.IsFavorite, Converter={toolkit:BoolToObjectConverter TrueObject='★ Added to My Agenda', FalseObject='☆ Add to My Agenda'}}"
                            Command="{Binding ToggleFavoriteCommand}"
                            BackgroundColor="{Binding Session.IsFavorite, Converter={toolkit:BoolToObjectConverter TrueObject={StaticResource Primary}, FalseObject=Transparent}}"
                            TextColor="{Binding Session.IsFavorite, Converter={toolkit:BoolToObjectConverter TrueObject=White, FalseObject={StaticResource Primary}}}"
                            BorderColor="{StaticResource Primary}"
                            BorderWidth="2"
                            CornerRadius="10"
                            FontAttributes="Bold"
                            FontSize="14"
                            HeightRequest="44" />

                    <!-- Description Section -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="ABOUT THIS SESSION"
                               FontSize="11"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}"
                               CharacterSpacing="0.5" />
                        <Label Text="{Binding Session.Description}"
                               FontSize="15"
                               LineHeight="1.5"
                               LineBreakMode="WordWrap"
                               TextColor="{AppThemeBinding Light={StaticResource Gray800}, Dark={StaticResource Gray200}}" />
                    </VerticalStackLayout>

                    <!-- Speakers Section -->
                    <VerticalStackLayout Spacing="10" IsVisible="{Binding Session.HasSpeaker1}">
                        <Label Text="SPEAKERS"
                               FontSize="11"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}"
                               CharacterSpacing="0.5" />

                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Session.Speakers}"
                                             Spacing="8">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:SpeakerItem">
                                    <Border Background="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 12"
                                            Padding="12">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnSpeakerTapped" />
                                        </Border.GestureRecognizers>
                                        <Grid ColumnDefinitions="48,*,Auto" ColumnSpacing="12">
                                            <!-- Speaker Avatar -->
                                            <Border Grid.Column="0"
                                                    StrokeShape="RoundRectangle 24"
                                                    HeightRequest="48"
                                                    WidthRequest="48"
                                                    StrokeThickness="0"
                                                    Background="{StaticResource Primary}">
                                                <Grid>
                                                    <!-- Fallback initials -->
                                                    <Label Text="{Binding Initials}"
                                                           TextColor="White"
                                                           FontSize="14"
                                                           FontAttributes="Bold"
                                                           HorizontalOptions="Center"
                                                           VerticalOptions="Center" />
                                                    <!-- Actual image -->
                                                    <Image Source="{Binding ProfilePictureUrl}"
                                                           Aspect="AspectFill"
                                                           HeightRequest="48"
                                                           WidthRequest="48">
                                                        <Image.Clip>
                                                            <EllipseGeometry Center="24,24" RadiusX="24" RadiusY="24" />
                                                        </Image.Clip>
                                                    </Image>
                                                </Grid>
                                            </Border>

                                            <!-- Speaker Info -->
                                            <VerticalStackLayout Grid.Column="1" 
                                                                 VerticalOptions="Center"
                                                                 Spacing="1">
                                                <Label Text="{Binding FullName}"
                                                       FontSize="15"
                                                       FontAttributes="Bold"
                                                       LineBreakMode="TailTruncation" />
                                                <Label Text="{Binding TagLine}"
                                                       FontSize="12"
                                                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                                                       LineBreakMode="TailTruncation"
                                                       MaxLines="1" />
                                            </VerticalStackLayout>

                                            <!-- Chevron -->
                                            <Label Grid.Column="2"
                                                   Text="›"
                                                   FontSize="20"
                                                   TextColor="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"
                                                   VerticalOptions="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <!-- Bottom padding for tab bar safe area on iOS -->
                    <BoxView HeightRequest="30" BackgroundColor="Transparent" />
                    
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
