<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Conference.Maui.ViewModels"
             xmlns:models="clr-namespace:Conference.Maui.Models"
             xmlns:controls="clr-namespace:Conference.Maui.Controls"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:syncfusion="clr-namespace:Syncfusion.Maui.Toolkit.TabView;assembly=Syncfusion.Maui.Toolkit"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             xmlns:behaviors="clr-namespace:Conference.Maui.Behaviors"
             x:Class="Conference.Maui.Pages.SessionsPage"
             x:Name="ThisPage"
             x:DataType="vm:SessionsViewModel"
             Title="{Binding Title}"
             SafeAreaEdges="None"
             Background="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray950}}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Command="{Binding NavigateToQuickPickCommand}" Order="Primary"
                     Text="Quick Pick"
                     IsEnabled="{Binding IsQuickPickEnabled}"
                     mi:MauiIcon.Value="{mi:Fluent Icon=Flash28}" />
    </ContentPage.ToolbarItems>


    <Grid RowDefinitions="Auto,Auto,*" SafeAreaEdges="None">
        <!-- Day Selector using SfTabView - hidden when searching -->
        <syncfusion:SfTabView x:Name="DaySwitcher"
                              Grid.Row="0"
                              HeightRequest="48"
                              TabBarPlacement="Top"
                              IndicatorPlacement="Bottom"
                              TabWidthMode="Default"
                              IndicatorWidthMode="Stretch"
                              SelectedIndex="{Binding SelectedDayIndex}"
                              IsVisible="{Binding ShowDaySwitcher}"
                              TabBarBackground="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray950}}"
                              IndicatorBackground="{StaticResource Primary}">
        </syncfusion:SfTabView>

        <!-- Search Bar -->
        <Border Grid.Row="1"
                Margin="16,8"
                StrokeShape="RoundRectangle 12"
                Stroke="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray500}}"
                StrokeThickness="1"
                Background="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}"
                Padding="0">
            <Grid ColumnDefinitions="Auto,*" Padding="12,0">
                <Image Grid.Column="0"
                       HeightRequest="18" WidthRequest="18"
                       VerticalOptions="Center"
                       Margin="0,0,8,0"
                       SemanticProperties.Description=""
                       mi:MauiIcon.Value="{mi:Fluent Icon=Search24, IconSize=18, IconColor={AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}}" />
                <Entry Grid.Column="1"
                       x:Name="SessionSearchEntry"
                       Placeholder="Search sessions..."
                       Text="{Binding SearchText}"
                       ClearButtonVisibility="WhileEditing"
                       FontSize="16"
                       VerticalOptions="Center"
                       BackgroundColor="Transparent"
                       SemanticProperties.Description="Search sessions"
                       PlaceholderColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}">
                    <Entry.Behaviors>
                        <toolkit:UserStoppedTypingBehavior
                            BindingContext="{Binding Path=BindingContext, Source={x:Reference SessionSearchEntry}, x:DataType=Entry}"
                            Command="{Binding ApplySearchCommand}"
                            StoppedTypingTimeThreshold="300"
                            MinimumLengthThreshold="1"
                            ShouldDismissKeyboardAutomatically="False" />
                    </Entry.Behaviors>
                    <Entry.Style>
                        <Style TargetType="Entry">
                            <Setter Property="VisualStateManager.VisualStateGroups">
                                <VisualStateGroupList>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal">
                                            <VisualState.Setters>
                                                <Setter Property="BackgroundColor" Value="Transparent" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Focused">
                                            <VisualState.Setters>
                                                <Setter Property="BackgroundColor" Value="Transparent" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateGroupList>
                            </Setter>
                        </Style>
                    </Entry.Style>
                </Entry>
            </Grid>
        </Border>

        <!-- Sessions CollectionView -->
        <RefreshView Grid.Row="2" IsRefreshing="{Binding IsRefreshing}"
                     Command="{Binding RefreshDataCommand}">
            <CollectionView x:Name="SessionsCollectionView"
                            ItemsSource="{Binding CurrentDaySlots}"
                            IsGrouped="True"
                            SelectionMode="Single"
                            SelectionChanged="OnSessionSelected">
                <CollectionView.Behaviors>
                    <behaviors:StickyHeaderHapticBehavior />
                </CollectionView.Behaviors>
                <CollectionView.GroupHeaderTemplate>
                    <DataTemplate x:DataType="models:TimeSlotGroup">
                        <Grid Background="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}"
                              Padding="12,8">
                            <Label Text="{Binding TimeDisplay}"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   SemanticProperties.HeadingLevel="Level2"
                                   TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource DarkPrimary}}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.GroupHeaderTemplate>
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:SessionItem">
                        <controls:SessionCardView />
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            <CollectionView.Footer>
                <!-- Tab bar padding -->
                <BoxView HeightRequest="90" BackgroundColor="Transparent" />
            </CollectionView.Footer>
            <CollectionView.EmptyView>
                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Padding="32" Spacing="12"
                                     IsVisible="{Binding IsBusy, Converter={toolkit:InvertedBoolConverter}}">
                    <Image HeightRequest="48" WidthRequest="48" HorizontalOptions="Center"
                           SemanticProperties.Description=""
                           mi:MauiIcon.Value="{mi:Fluent Icon=CalendarLtr24, IconSize=48, IconColor={AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}}" />
                    <Label Text="No sessions found"
                           FontSize="18"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
                    <Label Text="Try adjusting your search or check back later for schedule updates."
                           FontSize="14"
                           HorizontalTextAlignment="Center"
                           TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
        </CollectionView>
        </RefreshView>

        <!-- Loading Indicator -->
        <VerticalStackLayout Grid.RowSpan="3"
                             VerticalOptions="Center"
                             HorizontalOptions="Center"
                             Spacing="12"
                             IsVisible="{Binding IsBusy}">
            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               HorizontalOptions="Center"
                               Color="{StaticResource Primary}" />
            <Label Text="Loading sessions..."
                   FontSize="14"
                   HorizontalOptions="Center"
                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
