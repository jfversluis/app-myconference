<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Conference.Maui.ViewModels"
             xmlns:models="clr-namespace:Conference.Maui.Models"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="Conference.Maui.Pages.ConflictResolverPage"
             x:DataType="vm:ConflictResolverViewModel"
             Title="Resolve Conflicts"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray950}}"
             x:Name="resolver">

    <Grid RowDefinitions="Auto,*,Auto" SafeAreaEdges="Container">

        <!-- Header -->
        <Grid Grid.Row="0" Padding="20,12,20,12" ColumnDefinitions="*,Auto">
            <VerticalStackLayout Spacing="2">
                <Label Text="Resolve Conflicts" FontSize="22" FontAttributes="Bold"
                       SemanticProperties.HeadingLevel="Level1" />
                <Label FontSize="13"
                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="{Binding ConflictGroups.Count}" FontAttributes="Bold" />
                            <Span Text=" time slots to resolve" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
            </VerticalStackLayout>
            <Button Grid.Column="1"
                    mi:MauiIcon.Value="{mi:Fluent Icon=Dismiss12, IconColor={StaticResource Gray600}}"
                    Command="{Binding CloseCommand}"
                    BackgroundColor="Transparent"
                    FontSize="20"
                    Padding="8,4"
                    MinimumWidthRequest="48" MinimumHeightRequest="48"
                    VerticalOptions="Center"
                    SemanticProperties.Description="Close"
                    SemanticProperties.Hint="Double tap to close conflict resolver" />
        </Grid>

        <!-- Loading indicator -->
        <ActivityIndicator Grid.Row="1" IsRunning="{Binding IsBusy}"
                           IsVisible="{Binding IsBusy}"
                           HorizontalOptions="Center" VerticalOptions="Center"
                           Color="{StaticResource Primary}" />

        <!-- All resolved state -->
        <VerticalStackLayout Grid.Row="1" Spacing="12" Padding="32"
                             VerticalOptions="Center" HorizontalOptions="Center"
                             IsVisible="{Binding AllResolved}">
            <Image HeightRequest="48" WidthRequest="48" HorizontalOptions="Center"
                   SemanticProperties.Description=""
                   mi:MauiIcon.Value="{mi:Fluent Icon=Sparkle24, IconSize=48, IconColor={StaticResource Primary}}" />
            <Label Text="All conflicts resolved!" FontSize="22" FontAttributes="Bold"
                   HorizontalTextAlignment="Center" />
            <Label Text="Your agenda is now conflict-free."
                   FontSize="14"
                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                   HorizontalTextAlignment="Center" />
            <Button Text="View My Agenda"
                    Clicked="OnViewAgendaClicked"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="White"
                    FontSize="15" FontAttributes="Bold"
                    CornerRadius="12"
                    Padding="24,14"
                    HorizontalOptions="Center"
                    Margin="0,12,0,0" />
        </VerticalStackLayout>

        <!-- Conflict groups list -->
        <CollectionView Grid.Row="1" ItemsSource="{Binding ConflictGroups}"
                        IsVisible="{Binding AllResolved, Converter={StaticResource InvertedBoolConverter}}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:ConflictGroup">
                    <VerticalStackLayout Padding="16,8">
                        <!-- Time slot header -->
                        <Border StrokeThickness="0"
                                StrokeShape="RoundRectangle 12,12,0,0"
                                BackgroundColor="{AppThemeBinding Light={StaticResource WarningLight}, Dark={StaticResource WarningDark}}"
                                Padding="16,10">
                            <HorizontalStackLayout Spacing="8">
                                <Image HeightRequest="16" WidthRequest="16" VerticalOptions="Center"
                                       SemanticProperties.Description=""
                                       mi:MauiIcon.Value="{mi:Fluent Icon=Warning16, IconSize=16, IconColor={AppThemeBinding Light={StaticResource WarningText}, Dark={StaticResource WarningTextDark}}}" />
                                <Label Text="{Binding TimeSlotLabel}"
                                       FontSize="14" FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource WarningText}, Dark={StaticResource WarningTextDark}}"
                                       VerticalOptions="Center"
                                       SemanticProperties.HeadingLevel="Level2" />
                                <Label FontSize="12"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                                       VerticalOptions="Center">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text=" · " />
                                            <Span Text="{Binding SessionCount}" />
                                            <Span Text=" sessions overlap" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                            </HorizontalStackLayout>
                        </Border>

                        <!-- Sessions in this slot -->
                        <Border StrokeThickness="0"
                                StrokeShape="RoundRectangle 0,0,12,12"
                                BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}"
                                Padding="0">
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Sessions}" Spacing="0">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:SessionItem">
                                        <Border StrokeThickness="0"
                                                BackgroundColor="Transparent"
                                                Padding="16,14"
                                                MinimumHeightRequest="44"
                                                SemanticProperties.Description="{Binding AccessibleDescription}"
                                                SemanticProperties.Hint="Double tap to view session details">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnSessionTapped"
                                                    CommandParameter="{Binding}" />
                                            </Border.GestureRecognizers>
                                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                                                <Label Text="{Binding Title}"
                                                       FontSize="15" FontAttributes="Bold"
                                                       LineBreakMode="TailTruncation" MaxLines="2" />
                                                <Label Grid.Row="1" Text="{Binding SpeakerNames}"
                                                       FontSize="13"
                                                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                                                       LineBreakMode="TailTruncation" MaxLines="1"
                                                       Margin="0,2,0,0" />
                                                <HorizontalStackLayout Grid.Row="2" Spacing="6" Margin="0,4,0,0">
                                                    <Label Text="{Binding TimeDisplay}" FontSize="12"
                                                           TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
                                                    <Label Text="·" FontSize="12"
                                                           TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                                                           IsVisible="{Binding RoomName, Converter={toolkit:IsNotNullConverter}}" />
                                                    <Label Text="{Binding RoomName}" FontSize="12"
                                                           TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                                                           IsVisible="{Binding RoomName, Converter={toolkit:IsNotNullConverter}}" />
                                                </HorizontalStackLayout>

                                                <!-- Keep button -->
                                                <Button Grid.RowSpan="3" Grid.Column="1"
                                                        Text="Keep"
                                                        BackgroundColor="{StaticResource Primary}"
                                                        TextColor="White"
                                                        FontSize="13" FontAttributes="Bold"
                                                        CornerRadius="8"
                                                        Padding="14,8"
                                                        VerticalOptions="Center"
                                                        Clicked="OnKeepButtonClicked"
                                                        CommandParameter="{Binding}"
                                                        SemanticProperties.Hint="Double tap to keep this session and remove others" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Bottom bar with info and undo -->
        <Border Grid.Row="2" StrokeThickness="0"
                BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}"
                Padding="20,14,20,20"
                IsVisible="{Binding AllResolved, Converter={StaticResource InvertedBoolConverter}}">
            <Grid ColumnDefinitions="*,Auto">
                <Label Text="Tap a session to see details, or tap 'Keep' to resolve the conflict."
                       FontSize="13"
                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                       LineBreakMode="WordWrap"
                       VerticalOptions="Center" />
                <Button Grid.Column="1"
                        Clicked="OnUndoClicked"
                        SemanticProperties.Description="Undo"
                        SemanticProperties.Hint="Double tap to undo last action"
                        mi:MauiIcon.Value="{mi:Fluent Icon=ArrowUndo24, IconColor={StaticResource Primary}}"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}"
                        CornerRadius="20"
                        HeightRequest="44" WidthRequest="44"
                        Padding="0"
                        VerticalOptions="Center"
                        IsVisible="{Binding CanUndo}" />
            </Grid>
        </Border>
    </Grid>
</ContentPage>
