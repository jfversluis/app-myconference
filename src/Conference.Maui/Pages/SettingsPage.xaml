<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Conference.Maui.ViewModels"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             xmlns:conv="clr-namespace:Conference.Maui.Converters"
             x:Class="Conference.Maui.Pages.SettingsPage"
             x:DataType="vm:SettingsViewModel"
             Title="{Binding Title}"
             Background="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray950}}">

    <ContentPage.Resources>
        <conv:IndexToColorConverter x:Key="IndexToColorConverter" />
        <conv:IndexToTextColorConverter x:Key="IndexToTextColorConverter" />
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="16,20">

            <!-- Notifications Section -->
            <VerticalStackLayout Spacing="8">
                <Label Text="NOTIFICATIONS"
                       FontSize="11"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                       CharacterSpacing="0.5"
                       SemanticProperties.HeadingLevel="Level2" />

                <!-- Session Reminders Toggle -->
                <Border StrokeShape="RoundRectangle 12"
                        Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                        StrokeThickness="1"
                        Background="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}"
                        Padding="16">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Image Grid.Column="0" HeightRequest="24" WidthRequest="24" VerticalOptions="Center"
                               SemanticProperties.Description=""
                               mi:MauiIcon.Value="{mi:Fluent Icon=Alert24, IconColor={StaticResource Primary}}" />
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="Session Reminders" FontSize="15" FontAttributes="Bold" />
                            <Label Text="Get notified before favorited sessions start" FontSize="12"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="2" IsToggled="{Binding RemindersEnabled}" VerticalOptions="Center"
                                OnColor="{StaticResource Primary}"
                                SemanticProperties.Description="Session Reminders"
                                SemanticProperties.Hint="Double tap to toggle session reminder notifications" />
                    </Grid>
                </Border>

                <!-- Lead Time Picker -->
                <Border StrokeShape="RoundRectangle 12"
                        Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                        StrokeThickness="1"
                        Background="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}"
                        Padding="16"
                        IsVisible="{Binding RemindersEnabled}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Image Grid.Column="0" HeightRequest="24" WidthRequest="24" VerticalOptions="Center"
                               SemanticProperties.Description=""
                               mi:MauiIcon.Value="{mi:Fluent Icon=Timer24, IconColor={StaticResource Primary}}" />
                        <VerticalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                            <Label Text="Remind Me Before" FontSize="15" FontAttributes="Bold" />
                            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                                <Button Grid.Column="0" Text="5 min"
                                        FontSize="12" CornerRadius="10" HeightRequest="44"
                                        BackgroundColor="{Binding SelectedLeadTimeIndex, Converter={StaticResource IndexToColorConverter}, ConverterParameter=0}"
                                        TextColor="{Binding SelectedLeadTimeIndex, Converter={StaticResource IndexToTextColorConverter}, ConverterParameter=0}"
                                        Command="{Binding SetLeadTimeCommand}"
                                        CommandParameter="0"
                                        SemanticProperties.Description="5 minutes before"
                                        SemanticProperties.Hint="Double tap to set reminder lead time">
                                    <Button.Triggers>
                                        <DataTrigger TargetType="Button" Binding="{Binding SelectedLeadTimeIndex}" Value="0">
                                            <Setter Property="SemanticProperties.Description" Value="5 minutes before, currently selected" />
                                        </DataTrigger>
                                    </Button.Triggers>
                                </Button>
                                <Button Grid.Column="1" Text="10 min"
                                        FontSize="12" CornerRadius="10" HeightRequest="44"
                                        BackgroundColor="{Binding SelectedLeadTimeIndex, Converter={StaticResource IndexToColorConverter}, ConverterParameter=1}"
                                        TextColor="{Binding SelectedLeadTimeIndex, Converter={StaticResource IndexToTextColorConverter}, ConverterParameter=1}"
                                        Command="{Binding SetLeadTimeCommand}"
                                        CommandParameter="1"
                                        SemanticProperties.Description="10 minutes before"
                                        SemanticProperties.Hint="Double tap to set reminder lead time">
                                    <Button.Triggers>
                                        <DataTrigger TargetType="Button" Binding="{Binding SelectedLeadTimeIndex}" Value="1">
                                            <Setter Property="SemanticProperties.Description" Value="10 minutes before, currently selected" />
                                        </DataTrigger>
                                    </Button.Triggers>
                                </Button>
                                <Button Grid.Column="2" Text="15 min"
                                        FontSize="12" CornerRadius="10" HeightRequest="44"
                                        BackgroundColor="{Binding SelectedLeadTimeIndex, Converter={StaticResource IndexToColorConverter}, ConverterParameter=2}"
                                        TextColor="{Binding SelectedLeadTimeIndex, Converter={StaticResource IndexToTextColorConverter}, ConverterParameter=2}"
                                        Command="{Binding SetLeadTimeCommand}"
                                        CommandParameter="2"
                                        SemanticProperties.Description="15 minutes before"
                                        SemanticProperties.Hint="Double tap to set reminder lead time">
                                    <Button.Triggers>
                                        <DataTrigger TargetType="Button" Binding="{Binding SelectedLeadTimeIndex}" Value="2">
                                            <Setter Property="SemanticProperties.Description" Value="15 minutes before, currently selected" />
                                        </DataTrigger>
                                    </Button.Triggers>
                                </Button>
                                <Button Grid.Column="3" Text="30 min"
                                        FontSize="12" CornerRadius="10" HeightRequest="44"
                                        BackgroundColor="{Binding SelectedLeadTimeIndex, Converter={StaticResource IndexToColorConverter}, ConverterParameter=3}"
                                        TextColor="{Binding SelectedLeadTimeIndex, Converter={StaticResource IndexToTextColorConverter}, ConverterParameter=3}"
                                        Command="{Binding SetLeadTimeCommand}"
                                        CommandParameter="3"
                                        SemanticProperties.Description="30 minutes before"
                                        SemanticProperties.Hint="Double tap to set reminder lead time">
                                    <Button.Triggers>
                                        <DataTrigger TargetType="Button" Binding="{Binding SelectedLeadTimeIndex}" Value="3">
                                            <Setter Property="SemanticProperties.Description" Value="30 minutes before, currently selected" />
                                        </DataTrigger>
                                    </Button.Triggers>
                                </Button>
                            </Grid>
                        </VerticalStackLayout>
                    </Grid>
                </Border>
            </VerticalStackLayout>

            <!-- Preferences Section -->
            <VerticalStackLayout Spacing="8">
                <Label Text="PREFERENCES"
                       FontSize="11"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                       CharacterSpacing="0.5"
                       SemanticProperties.HeadingLevel="Level2" />

                <!-- Theme Picker -->
                <Border StrokeShape="RoundRectangle 12"
                        Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                        StrokeThickness="1"
                        Background="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}"
                        Padding="16">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Image Grid.Column="0" HeightRequest="24" WidthRequest="24" VerticalOptions="Center"
                               SemanticProperties.Description=""
                               mi:MauiIcon.Value="{mi:Fluent Icon=WeatherSunny24, IconColor={StaticResource Primary}}" />
                        <VerticalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                            <Label Text="Appearance" FontSize="15" FontAttributes="Bold" />
                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                <Button Grid.Column="0" Text="System"
                                        FontSize="13" CornerRadius="10" HeightRequest="44"
                                        BackgroundColor="{Binding SelectedThemeIndex, Converter={StaticResource IndexToColorConverter}, ConverterParameter=0}"
                                        TextColor="{Binding SelectedThemeIndex, Converter={StaticResource IndexToTextColorConverter}, ConverterParameter=0}"
                                        Command="{Binding SetThemeCommand}"
                                        CommandParameter="0"
                                        SemanticProperties.Description="System theme"
                                        SemanticProperties.Hint="Double tap to use system appearance">
                                    <Button.Triggers>
                                        <DataTrigger TargetType="Button" Binding="{Binding SelectedThemeIndex}" Value="0">
                                            <Setter Property="SemanticProperties.Description" Value="System theme, currently selected" />
                                        </DataTrigger>
                                    </Button.Triggers>
                                </Button>
                                <Button Grid.Column="1" Text="Light"
                                        FontSize="13" CornerRadius="10" HeightRequest="44"
                                        BackgroundColor="{Binding SelectedThemeIndex, Converter={StaticResource IndexToColorConverter}, ConverterParameter=1}"
                                        TextColor="{Binding SelectedThemeIndex, Converter={StaticResource IndexToTextColorConverter}, ConverterParameter=1}"
                                        Command="{Binding SetThemeCommand}"
                                        CommandParameter="1"
                                        SemanticProperties.Description="Light theme"
                                        SemanticProperties.Hint="Double tap to use light appearance">
                                    <Button.Triggers>
                                        <DataTrigger TargetType="Button" Binding="{Binding SelectedThemeIndex}" Value="1">
                                            <Setter Property="SemanticProperties.Description" Value="Light theme, currently selected" />
                                        </DataTrigger>
                                    </Button.Triggers>
                                </Button>
                                <Button Grid.Column="2" Text="Dark"
                                        FontSize="13" CornerRadius="10" HeightRequest="44"
                                        BackgroundColor="{Binding SelectedThemeIndex, Converter={StaticResource IndexToColorConverter}, ConverterParameter=2}"
                                        TextColor="{Binding SelectedThemeIndex, Converter={StaticResource IndexToTextColorConverter}, ConverterParameter=2}"
                                        Command="{Binding SetThemeCommand}"
                                        CommandParameter="2"
                                        SemanticProperties.Description="Dark theme"
                                        SemanticProperties.Hint="Double tap to use dark appearance">
                                    <Button.Triggers>
                                        <DataTrigger TargetType="Button" Binding="{Binding SelectedThemeIndex}" Value="2">
                                            <Setter Property="SemanticProperties.Description" Value="Dark theme, currently selected" />
                                        </DataTrigger>
                                    </Button.Triggers>
                                </Button>
                            </Grid>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- Haptic Feedback -->
                <Border StrokeShape="RoundRectangle 12"
                        Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                        StrokeThickness="1"
                        Background="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}"
                        Padding="16">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Image Grid.Column="0" HeightRequest="24" WidthRequest="24" VerticalOptions="Center"
                               SemanticProperties.Description=""
                               mi:MauiIcon.Value="{mi:Fluent Icon=Phone24, IconColor={StaticResource Primary}}" />
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="Haptic Feedback" FontSize="15" FontAttributes="Bold" />
                            <Label Text="Vibration on swipes and actions" FontSize="12"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="2" IsToggled="{Binding HapticFeedbackEnabled}" VerticalOptions="Center"
                                OnColor="{StaticResource Primary}"
                                SemanticProperties.Description="Haptic Feedback"
                                SemanticProperties.Hint="Double tap to toggle vibration on swipes and actions" />
                    </Grid>
                </Border>

                <!-- Clear Cache -->
                <Border StrokeShape="RoundRectangle 12"
                        Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                        StrokeThickness="1"
                        Background="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}"
                        Padding="16"
                        SemanticProperties.Description="Clear cached data"
                        SemanticProperties.Hint="Double tap to clear cache">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ClearCacheCommand}" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Image Grid.Column="0" HeightRequest="24" WidthRequest="24" VerticalOptions="Center"
                               SemanticProperties.Description=""
                               mi:MauiIcon.Value="{mi:Fluent Icon=Delete24, IconColor={StaticResource Primary}}" />
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="Clear Cache" FontSize="15" FontAttributes="Bold" />
                            <Label Text="Remove cached conference data" FontSize="12"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
                        </VerticalStackLayout>
                        <Image Grid.Column="2" HeightRequest="16" WidthRequest="16" VerticalOptions="Center"
                               SemanticProperties.Description=""
                               mi:MauiIcon.Value="{mi:Fluent Icon=ChevronRight20, IconColor={AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}}" />
                    </Grid>
                </Border>

                <!-- Replay Welcome -->
                <Border StrokeShape="RoundRectangle 12"
                        Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                        StrokeThickness="1"
                        Background="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}"
                        Padding="16"
                        SemanticProperties.Description="Replay welcome tour"
                        SemanticProperties.Hint="Double tap to restart onboarding">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ReplayOnboardingCommand}" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Image Grid.Column="0" HeightRequest="24" WidthRequest="24" VerticalOptions="Center"
                               SemanticProperties.Description=""
                               mi:MauiIcon.Value="{mi:Fluent Icon=Play24, IconColor={StaticResource Primary}}" />
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="Replay Welcome" FontSize="15" FontAttributes="Bold" />
                            <Label Text="Show the onboarding experience again" FontSize="12"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
                        </VerticalStackLayout>
                        <Image Grid.Column="2" HeightRequest="16" WidthRequest="16" VerticalOptions="Center"
                               SemanticProperties.Description=""
                               mi:MauiIcon.Value="{mi:Fluent Icon=ChevronRight20, IconColor={AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}}" />
                    </Grid>
                </Border>
            </VerticalStackLayout>

            <!-- App Info Section -->
            <VerticalStackLayout Spacing="8">
                <Label Text="APP INFO"
                       FontSize="11"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                       CharacterSpacing="0.5"
                       SemanticProperties.HeadingLevel="Level2" />

                <Border StrokeShape="RoundRectangle 12"
                        Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                        StrokeThickness="1"
                        Background="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}"
                        Padding="16">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Image Grid.Column="0" HeightRequest="24" WidthRequest="24" VerticalOptions="Center"
                               SemanticProperties.Description=""
                               mi:MauiIcon.Value="{mi:Fluent Icon=Phone24, IconColor={StaticResource Primary}}" />
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="{Binding AppName}" FontSize="16" FontAttributes="Bold" />
                            <Label Text="{Binding AppVersion}" FontSize="13"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <Border StrokeShape="RoundRectangle 12"
                        Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                        StrokeThickness="1"
                        Background="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}"
                        Padding="16">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Image Grid.Column="0" HeightRequest="24" WidthRequest="24" VerticalOptions="Center"
                               SemanticProperties.Description=""
                               mi:MauiIcon.Value="{mi:Fluent Icon=Wrench24, IconColor={StaticResource Primary}}" />
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="Built with" FontSize="12"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
                            <Label Text="{Binding Framework}" FontSize="16" FontAttributes="Bold" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>
            </VerticalStackLayout>

            <!-- Libraries Section -->
            <VerticalStackLayout Spacing="8">
                <Label Text="LIBRARIES"
                       FontSize="11"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                       CharacterSpacing="0.5"
                       SemanticProperties.HeadingLevel="Level2" />

                <Border StrokeShape="RoundRectangle 12"
                        Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                        StrokeThickness="1"
                        Background="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}"
                        Padding="0">
                    <VerticalStackLayout Spacing="0">
                        <!-- MAUI Community Toolkit -->
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Padding="16,14" MinimumHeightRequest="44"
                              SemanticProperties.Description="MAUI Community Toolkit, UI Components"
                              SemanticProperties.Hint="Double tap to open in browser">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenLibraryCommand}"
                                                      CommandParameter="https://github.com/CommunityToolkit/Maui" />
                            </Grid.GestureRecognizers>
                            <Label Grid.Column="0" Text="MAUI Community Toolkit" FontSize="14" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="UI Components" FontSize="12" VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
                            <Image Grid.Column="2" HeightRequest="12" WidthRequest="12" VerticalOptions="Center"
                                   SemanticProperties.Description=""
                                   mi:MauiIcon.Value="{mi:Fluent Icon=Open16, IconColor={AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}}" />
                        </Grid>
                        <BoxView HeightRequest="1" Margin="16,0" Color="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}" />

                        <!-- Syncfusion -->
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Padding="16,14" MinimumHeightRequest="44"
                              SemanticProperties.Description="Syncfusion MAUI Toolkit, Tab View"
                              SemanticProperties.Hint="Double tap to open in browser">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenLibraryCommand}"
                                                      CommandParameter="https://github.com/syncfusion/maui-toolkit" />
                            </Grid.GestureRecognizers>
                            <Label Grid.Column="0" Text="Syncfusion MAUI Toolkit" FontSize="14" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="Tab View" FontSize="12" VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
                            <Image Grid.Column="2" HeightRequest="12" WidthRequest="12" VerticalOptions="Center"
                                   SemanticProperties.Description=""
                                   mi:MauiIcon.Value="{mi:Fluent Icon=Open16, IconColor={AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}}" />
                        </Grid>
                        <BoxView HeightRequest="1" Margin="16,0" Color="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}" />

                        <!-- Akavache -->
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Padding="16,14" MinimumHeightRequest="44"
                              SemanticProperties.Description="Akavache, Offline Caching"
                              SemanticProperties.Hint="Double tap to open in browser">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenLibraryCommand}"
                                                      CommandParameter="https://github.com/reactiveui/Akavache" />
                            </Grid.GestureRecognizers>
                            <Label Grid.Column="0" Text="Akavache" FontSize="14" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="Offline Caching" FontSize="12" VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
                            <Image Grid.Column="2" HeightRequest="12" WidthRequest="12" VerticalOptions="Center"
                                   SemanticProperties.Description=""
                                   mi:MauiIcon.Value="{mi:Fluent Icon=Open16, IconColor={AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}}" />
                        </Grid>
                        <BoxView HeightRequest="1" Margin="16,0" Color="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}" />

                        <!-- Polly -->
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Padding="16,14" MinimumHeightRequest="44"
                              SemanticProperties.Description="Polly, Resilient HTTP"
                              SemanticProperties.Hint="Double tap to open in browser">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenLibraryCommand}"
                                                      CommandParameter="https://github.com/App-vNext/Polly" />
                            </Grid.GestureRecognizers>
                            <Label Grid.Column="0" Text="Polly" FontSize="14" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="Resilient HTTP" FontSize="12" VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
                            <Image Grid.Column="2" HeightRequest="12" WidthRequest="12" VerticalOptions="Center"
                                   SemanticProperties.Description=""
                                   mi:MauiIcon.Value="{mi:Fluent Icon=Open16, IconColor={AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}}" />
                        </Grid>
                        <BoxView HeightRequest="1" Margin="16,0" Color="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}" />

                        <!-- Sessionize -->
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Padding="16,14" MinimumHeightRequest="44"
                              SemanticProperties.Description="Sessionize API Client, Conference Data"
                              SemanticProperties.Hint="Double tap to open in browser">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenLibraryCommand}"
                                                      CommandParameter="https://sessionize.com" />
                            </Grid.GestureRecognizers>
                            <Label Grid.Column="0" Text="Sessionize API Client" FontSize="14" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="Conference Data" FontSize="12" VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
                            <Image Grid.Column="2" HeightRequest="12" WidthRequest="12" VerticalOptions="Center"
                                   SemanticProperties.Description=""
                                   mi:MauiIcon.Value="{mi:Fluent Icon=Open16, IconColor={AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!-- Links Section -->
            <VerticalStackLayout Spacing="8">
                <Label Text="LINKS"
                       FontSize="11"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                       CharacterSpacing="0.5"
                       SemanticProperties.HeadingLevel="Level2" />

                <Border StrokeShape="RoundRectangle 12"
                        Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                        StrokeThickness="1"
                        Background="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}"
                        Padding="16"
                        SemanticProperties.Description="View source code on GitHub"
                        SemanticProperties.Hint="Double tap to open">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenGitHubCommand}" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Image Grid.Column="0" HeightRequest="24" WidthRequest="24" VerticalOptions="Center"
                               SemanticProperties.Description=""
                               mi:MauiIcon.Value="{mi:Fluent Icon=Code24, IconColor={StaticResource Primary}}" />
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="View Source Code" FontSize="15" FontAttributes="Bold" />
                            <Label Text="Open-source on GitHub" FontSize="12"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
                        </VerticalStackLayout>
                        <Image Grid.Column="2" HeightRequest="16" WidthRequest="16" VerticalOptions="Center"
                               SemanticProperties.Description=""
                               mi:MauiIcon.Value="{mi:Fluent Icon=Open16, IconColor={StaticResource Primary}}" />
                    </Grid>
                </Border>

                <Border StrokeShape="RoundRectangle 12"
                        Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                        StrokeThickness="1"
                        Background="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}"
                        Padding="16"
                        SemanticProperties.Description="Powered by Sessionize"
                        SemanticProperties.Hint="Double tap to open">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenSessionizeCommand}" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Image Grid.Column="0" HeightRequest="24" WidthRequest="24" VerticalOptions="Center"
                               SemanticProperties.Description=""
                               mi:MauiIcon.Value="{mi:Fluent Icon=Flash24, IconColor={StaticResource Primary}}" />
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="Powered by Sessionize" FontSize="15" FontAttributes="Bold" />
                            <Label Text="Conference management platform" FontSize="12"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
                        </VerticalStackLayout>
                        <Image Grid.Column="2" HeightRequest="16" WidthRequest="16" VerticalOptions="Center"
                               SemanticProperties.Description=""
                               mi:MauiIcon.Value="{mi:Fluent Icon=Open16, IconColor={StaticResource Primary}}" />
                    </Grid>
                </Border>
            </VerticalStackLayout>

            <BoxView HeightRequest="60" BackgroundColor="Transparent" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
